{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "jsx": "preserve"
  },
  "include": [
    "src/**/*.ts",
    "src/env.d.ts",
    "tests/**/*.ts",
    "tests/**/*.d.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
