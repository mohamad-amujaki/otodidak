---
import { env } from 'cloudflare:workers';
import Shell from '../components/Shell.astro';
import { formatIdr, formatWhen } from '../domain/format';
import { isRecord, record } from '../domain/guard';
import { callApi, errorOf } from '../server/call';

const meResult = await callApi(Astro.request, env, '/api/me');
if (meResult.status !== 200) return Astro.redirect('/masuk');
const me = record(meResult.data);
const user = record(me.user);
let message = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('csrf') ?? '') !== Astro.locals.csrf)
    message = 'Muat ulang halaman, lalu kirim lagi.';
  else {
    const result = await callApi(Astro.request, env, '/api/credit-orders', {
      method: 'POST',
      json: { packId: String(form.get('packId') ?? '') },
      csrf: Astro.locals.csrf,
    });
    const error = errorOf(result.data);
    if (error) message = error.message;
    else if (isRecord(result.data) && typeof result.data.id === 'string')
      return Astro.redirect(`/kredit/pesanan/${result.data.id}`);
  }
}
const packsResult = await callApi(Astro.request, env, '/api/credit-packs');
const creditResult = await callApi(Astro.request, env, '/api/credits');
const packs =
  isRecord(packsResult.data) && Array.isArray(packsResult.data.packs)
    ? packsResult.data.packs.filter(isRecord)
    : [];
const credit = record(creditResult.data);
const entries = Array.isArray(credit.entries)
  ? credit.entries.filter(isRecord)
  : [];
const orders = Array.isArray(credit.orders)
  ? credit.orders.filter(isRecord)
  : [];
const reasons: Record<string, string> = {
  signup_grant: 'Kredit awal',
  purchase: 'Pembelian',
  roadmap: 'Jalur',
  lesson: 'Pelajaran',
  quiz: 'Kuis',
  refund: 'Pengembalian',
  admin_adjust: 'Penyesuaian',
};
const reasonIcons: Record<string, string> = {
  signup_grant: 'gift',
  purchase: 'shopping-bag',
  roadmap: 'map',
  lesson: 'book',
  quiz: 'brain',
  refund: 'arrow-left',
  admin_adjust: 'settings',
};
---
<Shell title="Kredit" balance={typeof me.balance === 'number' ? me.balance : 0} role={user.role === 'admin' ? 'admin' : 'learner'} suspended={user.status === 'suspended'}>
  <!-- Header Section -->
  <div class="mb-6">
    <h1 class="judul">Kredit</h1>
    <div class="mt-4 rounded-kartu border border-garis bg-gradient-to-br from-jalur-lembut to-kartu p-6 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="flex size-12 shrink-0 items-center justify-center rounded-kontrol bg-jalur-lembut text-jalur">
          <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-tinta-lembut">Saldo Kredit</p>
          <p class="text-3xl font-bold tabular-nums tracking-tight text-tinta min-[768px]:text-4xl">{me.balance}</p>
        </div>
      </div>
    </div>
  </div>

  {message && (
    <div class="mb-6 rounded-kontrol border border-bahaya/30 bg-bahaya/10 p-4">
      <div class="flex gap-3">
        <svg class="size-5 shrink-0 text-bahaya" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-sm text-bahaya">{message}</p>
      </div>
    </div>
  )}

  <!-- Credit Packs Section -->
  <section class="mb-12">
    <h2 class="text-xl font-bold text-tinta">Paket Kredit</h2>
    <ul class="mt-4 grid gap-4 min-[768px]:grid-cols-2 min-[1100px]:grid-cols-3">
      {packs.map((pack, index) => {
        const isPopular = index === 1;
        const isBestValue = index === 2;
        return (
          <li class="group relative flex flex-col overflow-hidden rounded-kartu border border-garis bg-kartu shadow-sm transition-all hover:shadow-md hover:border-jalur/30">
            {isPopular && (
              <div class="absolute right-0 top-0 z-10">
                <div class="rounded-bl-kontrol bg-hangat px-3 py-1 text-xs font-semibold text-white">
                  Paling Populer
                </div>
              </div>
            )}
            {isBestValue && (
              <div class="absolute right-0 top-0 z-10">
                <div class="rounded-bl-kontrol bg-jalur px-3 py-1 text-xs font-semibold text-white">
                  Best Value
                </div>
              </div>
            )}
            <div class="flex flex-1 flex-col p-6">
              <div class="mb-3 flex items-center gap-2">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-kontrol bg-jalur-lembut text-jalur">
                  <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-tinta">{pack.name}</h3>
              </div>
              <p class="text-3xl font-bold tabular-nums text-jalur">{pack.credits}</p>
              <p class="text-sm text-tinta-lembut">kredit</p>
              <div class="my-4 border-t border-garis"></div>
              <p class="text-2xl font-bold text-tinta">{formatIdr(Number(pack.priceIdr))}</p>
              <form method="post" class="mt-4">
                <input type="hidden" name="csrf" value={Astro.locals.csrf} />
                <input type="hidden" name="packId" value={String(pack.id)} />
                <button 
                  class="flex w-full min-h-11 items-center justify-center gap-2 rounded-kontrol bg-jalur px-4 font-semibold text-white shadow-md transition-all hover:shadow-lg hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60" 
                  type="submit" 
                  disabled={user.status === 'suspended'}
                >
                  <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
                  </svg>
                  Bayar dengan QRIS
                </button>
              </form>
            </div>
          </li>
        );
      })}
    </ul>
    <div class="mt-6 rounded-kontrol border border-garis bg-kartu p-4">
      <div class="flex items-start gap-3">
        <svg class="size-5 shrink-0 text-jalur" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-semibold text-tinta">Pembayaran Aman</p>
          <p class="mt-1 text-sm text-tinta-lembut">Transaksi diproses dengan aman melalui QRIS. Kredit akan otomatis ditambahkan setelah pembayaran berhasil.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Transaction History Section -->
  <section class="mb-12 max-w-3xl">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-bold text-tinta">Buku Besar</h2>
      {entries.length > 0 && (
        <span class="rounded-kontrol bg-jalur-lembut px-3 py-1 text-sm font-medium text-jalur">
          {entries.length} transaksi
        </span>
      )}
    </div>
    {entries.length === 0 ? (
      <div class="mt-4 rounded-kartu border border-garis bg-kartu p-8 text-center">
        <div class="mx-auto flex size-12 items-center justify-center rounded-kontrol bg-jalur-lembut text-jalur">
          <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <p class="mt-3 font-medium text-tinta">Belum ada transaksi</p>
        <p class="mt-1 text-sm text-tinta-lembut">Riwayat transaksi kredit akan muncul di sini</p>
      </div>
    ) : (
      <ul class="mt-4 grid gap-3">
        {entries.map((entry) => {
          const reason = String(entry.reason);
          const iconType = reasonIcons[reason] || 'circle';
          const amount = Number(entry.amount);
          const isPositive = amount > 0;
          return (
            <li class="flex items-center gap-4 rounded-kartu border border-garis bg-kartu p-4 shadow-sm transition-all hover:shadow-md">
              <div class={`flex size-10 shrink-0 items-center justify-center rounded-kontrol ${isPositive ? 'bg-jalur-lembut text-jalur' : 'bg-kertas text-tinta-lembut'}`}>
                {iconType === 'gift' && (
                  <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
                  </svg>
                )}
                {iconType === 'shopping-bag' && (
                  <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                  </svg>
                )}
                {iconType === 'map' && (
                  <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                  </svg>
                )}
                {iconType === 'book' && (
                  <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                )}
                {iconType === 'brain' && (
                  <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
                )}
                {iconType === 'arrow-left' && (
                  <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
                  </svg>
                )}
                {iconType === 'settings' && (
                  <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                )}
                {iconType === 'circle' && (
                  <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                  </svg>
                )}
              </div>
              <div class="min-w-0 flex-1">
                <p class="font-medium text-tinta">{reasons[reason] ?? reason}</p>
                <p class="text-sm text-tinta-lembut">{formatWhen(String(entry.createdAt))}</p>
              </div>
              <div class="text-right">
                <p class={`text-lg font-bold tabular-nums ${isPositive ? 'text-jalur' : 'text-bahaya'}`}>
                  {isPositive ? '+' : ''}{amount}
                </p>
              </div>
            </li>
          );
        })}
      </ul>
    )}
  </section>

  <!-- Orders Section -->
  <section class="max-w-3xl">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-bold text-tinta">Pesanan</h2>
      {orders.length > 0 && (
        <span class="rounded-kontrol bg-jalur-lembut px-3 py-1 text-sm font-medium text-jalur">
          {orders.length} pesanan
        </span>
      )}
    </div>
    {orders.length === 0 ? (
      <div class="mt-4 rounded-kartu border border-garis bg-kartu p-8 text-center">
        <div class="mx-auto flex size-12 items-center justify-center rounded-kontrol bg-jalur-lembut text-jalur">
          <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <p class="mt-3 font-medium text-tinta">Belum ada pesanan</p>
        <p class="mt-1 text-sm text-tinta-lembut">Pesanan kredit akan muncul di sini</p>
      </div>
    ) : (
      <ul class="mt-4 grid gap-3">
        {orders.map((order) => {
          const status = String(order.status);
          const statusConfig = {
            pending: {
              label: 'Menunggu Pembayaran',
              color: 'bg-hangat-lembut text-hangat border-hangat/30',
              icon: 'clock'
            },
            paid: {
              label: 'Berhasil',
              color: 'bg-jalur-lembut text-jalur border-jalur/30',
              icon: 'check'
            },
            failed: {
              label: 'Gagal',
              color: 'bg-bahaya/10 text-bahaya border-bahaya/30',
              icon: 'x'
            }
          };
          const config = statusConfig[status as keyof typeof statusConfig] || statusConfig.failed;
          return (
            <li>
              <a 
                class="flex items-center gap-4 rounded-kartu border border-garis bg-kartu p-4 shadow-sm transition-all hover:shadow-md hover:border-jalur/30" 
                href={`/kredit/pesanan/${String(order.id)}`}
              >
                <div class={`flex size-10 shrink-0 items-center justify-center rounded-kontrol ${config.color.split(' ')[0]}`}>
                  {config.icon === 'clock' && (
                    <svg class={`size-5 ${config.color.split(' ')[1]}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  )}
                  {config.icon === 'check' && (
                    <svg class={`size-5 ${config.color.split(' ')[1]}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                  )}
                  {config.icon === 'x' && (
                    <svg class={`size-5 ${config.color.split(' ')[1]}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  )}
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2">
                    <p class="font-medium text-tinta">{formatWhen(String(order.createdAt))}</p>
                    <span class={`rounded px-2 py-0.5 text-xs font-medium border ${config.color}`}>
                      {config.label}
                    </span>
                  </div>
                  <p class="mt-1 text-sm text-tinta-lembut">
                    {order.credits} kredit · {formatIdr(Number(order.amountIdr))}
                  </p>
                </div>
                <svg class="size-5 shrink-0 text-tinta-lembut" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </section>
</Shell>
