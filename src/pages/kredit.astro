---
import { env } from 'cloudflare:workers';
import LedgerRows from '../components/credit/LedgerRows.astro';
import OrderRows from '../components/credit/OrderRows.astro';
import Shell from '../components/Shell.astro';
import { formatIdr } from '../domain/format';
import { isRecord, record } from '../domain/guard';
import { callApi, errorOf } from '../server/call';

const SNIPPET_ENTRIES = 5;
const PENDING_SNIPPET = 2;

const meResult = await callApi(Astro.request, env, '/api/me');
if (meResult.status !== 200) return Astro.redirect('/masuk');
const me = record(meResult.data);
const user = record(me.user);
let message = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('csrf') ?? '') !== Astro.locals.csrf)
    message = 'Muat ulang halaman, lalu kirim lagi.';
  else {
    const result = await callApi(Astro.request, env, '/api/credit-orders', {
      method: 'POST',
      json: { packId: String(form.get('packId') ?? '') },
      csrf: Astro.locals.csrf,
    });
    const error = errorOf(result.data);
    if (error) message = error.message;
    else if (isRecord(result.data) && typeof result.data.id === 'string')
      return Astro.redirect(`/kredit/pesanan/${result.data.id}`);
  }
}
const packsResult = await callApi(Astro.request, env, '/api/credit-packs');
const creditParams = new URLSearchParams({
  limit: String(SNIPPET_ENTRIES),
  offset: '0',
  ordersLimit: '0',
  includePending: '1',
});
const creditResult = await callApi(
  Astro.request,
  env,
  `/api/credits?${creditParams}`,
);
const packs =
  isRecord(packsResult.data) && Array.isArray(packsResult.data.packs)
    ? packsResult.data.packs.filter(isRecord)
    : [];
const credit = record(creditResult.data);
const entries = Array.isArray(credit.entries)
  ? credit.entries.filter(isRecord)
  : [];
const pendingOrders = Array.isArray(credit.pendingOrders)
  ? credit.pendingOrders.filter(isRecord)
  : [];
const pendingSnippet = pendingOrders.slice(0, PENDING_SNIPPET);
const entriesTotal =
  typeof credit.entriesTotal === 'number'
    ? credit.entriesTotal
    : entries.length;
const ordersTotal =
  typeof credit.ordersTotal === 'number' ? credit.ordersTotal : 0;
const pendingTotal =
  typeof credit.pendingOrdersTotal === 'number'
    ? credit.pendingOrdersTotal
    : pendingOrders.length;
const summaryBlock = isRecord(credit.summary30d) ? credit.summary30d : {};
const summary = {
  added: Number(summaryBlock.added ?? 0),
  used: Number(summaryBlock.used ?? 0),
  net: Number(summaryBlock.net ?? 0),
};
const showSummary = summary.added > 0 || summary.used < 0;
---
<Shell title="Kredit" balance={typeof me.balance === 'number' ? me.balance : 0} role={user.role === 'admin' ? 'admin' : 'learner'} suspended={user.status === 'suspended'}>
  <div class="mx-auto w-full max-w-6xl">
    <div class="mb-6">
      <h1 class="judul">Kredit</h1>
      <div class="mt-4 rounded-kartu border border-garis bg-gradient-to-br from-jalur-lembut to-kartu p-5 shadow-sm min-[640px]:p-6">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="flex size-11 shrink-0 items-center justify-center rounded-kontrol bg-jalur-lembut text-jalur min-[640px]:size-12">
              <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
              </svg>
            </div>
            <div>
              <p class="text-sm text-tinta-lembut">Saldo kredit</p>
              <p class="text-3xl font-bold tabular-nums tracking-tight text-tinta">{me.balance}</p>
              {showSummary && (
                <p class="mt-1 text-xs text-tinta-lembut min-[480px]:text-sm">
                  <span class="text-jalur">+{summary.added}</span>
                  {' · '}
                  <span class="text-bahaya">{summary.used}</span>
                  {' · '}
                  neto{' '}
                  <span class={summary.net >= 0 ? 'text-jalur' : 'text-bahaya'}>
                    {summary.net >= 0 ? '+' : ''}{summary.net}
                  </span>
                  <span class="hidden min-[640px]:inline"> (30 hari)</span>
                </p>
              )}
            </div>
          </div>
          <a
            class="inline-flex min-h-11 items-center rounded-kontrol border border-jalur bg-jalur px-4 text-sm font-semibold text-white shadow-sm hover:brightness-110"
            href="#paket-kredit"
          >
            Beli kredit
          </a>
        </div>
      </div>
    </div>

    {pendingTotal > 0 && (
      <a
        class="mb-6 flex items-center gap-3 rounded-kontrol border border-hangat/30 bg-hangat-lembut px-4 py-3 transition-colors hover:border-hangat/50"
        href="/kredit/pesanan?status=pending"
      >
        <svg class="size-5 shrink-0 text-hangat" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="min-w-0 flex-1 text-sm font-semibold text-tinta">
          {pendingTotal === 1
            ? '1 pesanan menunggu pembayaran'
            : `${pendingTotal} pesanan menunggu pembayaran`}
        </p>
        <svg class="size-5 shrink-0 text-hangat" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    )}

    {message && (
      <div class="mb-6 rounded-kontrol border border-bahaya/30 bg-bahaya/10 p-4">
        <p class="text-sm text-bahaya">{message}</p>
      </div>
    )}

    <div class="grid gap-8 min-[900px]:grid-cols-2 min-[900px]:items-start min-[900px]:gap-10">
      <section class="order-2 min-[900px]:order-1" id="paket-kredit">
        <h2 class="text-lg font-bold text-tinta">Paket Kredit</h2>
        <ul class="mt-3 grid gap-3">
          {packs.map((pack, index) => {
            const isPopular = index === 1;
            const isBestValue = index === 2;
            return (
              <li class="relative overflow-hidden rounded-kartu border border-garis bg-kartu shadow-sm">
                {isPopular && (
                  <div class="absolute right-0 top-0 z-10">
                    <div class="rounded-bl-kontrol bg-hangat px-2.5 py-0.5 text-xs font-semibold text-white">
                      Populer
                    </div>
                  </div>
                )}
                {isBestValue && (
                  <div class="absolute right-0 top-0 z-10">
                    <div class="rounded-bl-kontrol bg-jalur px-2.5 py-0.5 text-xs font-semibold text-white">
                      Best Value
                    </div>
                  </div>
                )}
                <div class="flex flex-col gap-3 p-4 min-[900px]:flex-row min-[900px]:items-center min-[900px]:justify-between">
                  <div class="min-w-0">
                    <h3 class="font-semibold text-tinta">{pack.name}</h3>
                    <p class="mt-0.5 text-sm text-tinta-lembut">
                      <span class="text-lg font-bold tabular-nums text-jalur">{pack.credits}</span> kredit ·{' '}
                      <span class="font-semibold text-tinta">{formatIdr(Number(pack.priceIdr))}</span>
                    </p>
                  </div>
                  <form method="post" class="min-[900px]:shrink-0">
                    <input type="hidden" name="csrf" value={Astro.locals.csrf} />
                    <input type="hidden" name="packId" value={String(pack.id)} />
                    <button
                      class="flex w-full min-h-11 items-center justify-center gap-2 rounded-kontrol bg-jalur px-4 text-sm font-semibold text-white hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60 min-[900px]:w-auto"
                      type="submit"
                      disabled={user.status === 'suspended'}
                    >
                      Bayar QRIS
                    </button>
                  </form>
                </div>
              </li>
            );
          })}
        </ul>
        <p class="mt-3 flex items-center gap-2 text-xs text-tinta-lembut">
          <svg class="size-4 shrink-0 text-jalur" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          Pembayaran aman via QRIS; kredit masuk otomatis setelah bayar.
        </p>
      </section>

      <div class="order-1 flex flex-col gap-8 min-[900px]:order-2">
        <section>
          <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="text-lg font-bold text-tinta">Buku besar</h2>
            {entriesTotal > 0 && (
              <p class="text-xs text-tinta-lembut">
                {Math.min(SNIPPET_ENTRIES, entries.length)} dari {entriesTotal}
              </p>
            )}
          </div>
          {entriesTotal === 0 ? (
            <div class="rounded-kartu border border-garis bg-kartu px-4 py-6 text-center text-sm text-tinta-lembut">
              Belum ada transaksi
            </div>
          ) : (
            <>
              <LedgerRows entries={entries} dense linkable />
              {entriesTotal > SNIPPET_ENTRIES && (
                <a
                  class="mt-3 inline-flex min-h-10 items-center text-sm font-semibold text-jalur hover:underline"
                  href="/kredit/riwayat"
                >
                  Semua riwayat ({entriesTotal})
                </a>
              )}
            </>
          )}
        </section>

        {(pendingSnippet.length > 0 || ordersTotal > 0) && (
          <section>
            <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
              <h2 class="text-lg font-bold text-tinta">Pesanan</h2>
              {ordersTotal > 0 && (
                <a class="text-xs font-medium text-jalur hover:underline" href="/kredit/pesanan">
                  Semua ({ordersTotal})
                </a>
              )}
            </div>
            {pendingSnippet.length === 0 ? (
              <p class="text-sm text-tinta-lembut">
                Tidak ada yang menunggu bayar.{' '}
                <a class="font-medium text-jalur hover:underline" href="/kredit/pesanan">
                  Lihat riwayat pesanan
                </a>
              </p>
            ) : (
              <>
                <OrderRows orders={pendingSnippet} dense />
                {pendingTotal > PENDING_SNIPPET && (
                  <a
                    class="mt-3 inline-flex min-h-10 items-center text-sm font-semibold text-jalur hover:underline"
                    href="/kredit/pesanan?status=pending"
                  >
                    +{pendingTotal - PENDING_SNIPPET} pending lainnya
                  </a>
                )}
              </>
            )}
          </section>
        )}
      </div>
    </div>
  </div>
</Shell>
