---
import { env } from 'cloudflare:workers';
import Shell from '../components/Shell.astro';
import { activePublishableKey, clerkHost } from '../domain/guard';
import { callApi, errorOf } from '../server/call';

const mock = env.CLERK_SECRET_KEY === 'mock';
const session = await callApi(Astro.request, env, '/api/me');
if (session.status === 200) return Astro.redirect('/dasbor');

let message = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('csrf') ?? '') !== Astro.locals.csrf)
    message = 'Muat ulang halaman, lalu kirim lagi.';
  else if (mock) {
    const result = await callApi(Astro.request, env, '/api/dev/session', {
      method: 'POST',
      json: {
        email: String(form.get('email') ?? ''),
        name: String(form.get('name') ?? ''),
      },
      csrf: Astro.locals.csrf,
    });
    const error = errorOf(result.data);
    if (error) message = error.message;
    else {
      const headers = new Headers({ Location: '/dasbor' });
      for (const cookie of result.setCookie)
        headers.append('set-cookie', cookie);
      return new Response(null, { status: 303, headers });
    }
  }
}
const publishableKey = activePublishableKey(
  env.PUBLIC_CLERK_PUBLISHABLE_KEY,
  import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY,
  env.CLERK_PUBLISHABLE_KEY,
);
const host = clerkHost(publishableKey);
---
<Shell title="Masuk">
  <div class="max-w-md">
    <h1 class="judul">Masuk</h1>
    <p class="mt-2 text-tinta-lembut">Tidak ada kata sandi.</p>
    {mock ? (
      <form class="mt-6 grid gap-4" method="post">
        <input type="hidden" name="csrf" value={Astro.locals.csrf} />
        <p class="text-sm leading-[1.4] text-tinta-lembut">Lingkungan lokal memakai sesi percobaan sampai kunci Clerk diisi.</p>
        <div>
          <label class="block text-sm" for="email">Email</label>
          <input class="mt-1 rounded-kontrol border border-garis bg-kartu" id="email" name="email" type="email" required />
        </div>
        <div>
          <label class="block text-sm" for="name">Nama</label>
          <input class="mt-1 rounded-kontrol border border-garis bg-kartu" id="name" name="name" required />
        </div>
        {message && <p class="text-sm text-bahaya">{message}</p>}
        <button class="w-full rounded-kontrol bg-jalur px-4 text-white min-[768px]:w-auto" type="submit">Masuk dengan Google</button>
      </form>
    ) : (
      <>
        <meta name="clerk-key" content={publishableKey} />
        {host && <meta name="clerk-host" content={host} />}
        <button class="mt-6 w-full rounded-kontrol bg-jalur px-4 text-white min-[768px]:w-auto" id="google" type="button">Masuk dengan Google</button>
        <script type="module" src="/scripts/masuk.js"></script>
      </>
    )}
  </div>
</Shell>
