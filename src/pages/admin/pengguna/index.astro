---
import { env } from 'cloudflare:workers';
import AdminPagination from '../../../components/AdminPagination.astro';
import AdminShell from '../../../components/AdminShell.astro';
import { isRecord } from '../../../domain/guard';
import { roleLabel, statusLabel, runAdminAction } from '../../../server/admin-actions';
import { requireAdmin } from '../../../server/admin-guard';
import { callApi } from '../../../server/call';

const auth = await requireAdmin(Astro.request);
if ('redirect' in auth) return Astro.redirect(auth.redirect);

let message = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('csrf') ?? '') !== Astro.locals.csrf)
    message = 'Muat ulang halaman, lalu kirim lagi.';
  else message = await runAdminAction(Astro.request, env, Astro.locals.csrf, form);
}

const q = Astro.url.searchParams.get('q') ?? '';
const offset = Number(Astro.url.searchParams.get('offset') ?? 0);
const limit = Number(Astro.url.searchParams.get('limit') ?? 20);
const params = new URLSearchParams({ limit: String(limit), offset: String(offset) });
if (q) params.set('q', q);

const usersResult = await callApi(Astro.request, env, `/api/admin/users?${params}`);
const users =
  isRecord(usersResult.data) && Array.isArray(usersResult.data.users)
    ? usersResult.data.users.filter(isRecord)
    : [];
---
<AdminShell title="Pengguna" section="pengguna" balance={auth.balance} superadmin={auth.superadmin}>
  <h1 class="judul">Pengguna</h1>
  {message && <p class="mt-3 text-sm">{message}</p>}

  <form method="get" class="mt-6 grid gap-2 min-[768px]:grid-cols-[minmax(0,1fr)_auto] min-[768px]:items-center">
    <label class="sr-only" for="q">Cari</label>
    <input
      class="min-h-11 rounded-kontrol border border-garis bg-kartu px-3"
      id="q"
      name="q"
      type="search"
      value={q}
      placeholder="Cari nama atau email"
      autocomplete="off"
    />
    <button class="min-h-11 rounded-kontrol border border-garis bg-kartu px-4" type="submit">Cari</button>
  </form>

  {users.length === 0 && <p class="mt-6 text-tinta-lembut">Tidak ada pengguna.</p>}
  {users.length > 0 && (
    <div class="mt-6 space-y-3 min-[1100px]:space-y-0 min-[1100px]:overflow-hidden min-[1100px]:rounded-kartu min-[1100px]:border min-[1100px]:border-garis min-[1100px]:bg-kartu">
      <div class="hidden min-[1100px]:grid min-[1100px]:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_5rem_5rem_5rem_auto] min-[1100px]:gap-3 min-[1100px]:border-b min-[1100px]:border-garis min-[1100px]:px-4 min-[1100px]:py-3 min-[1100px]:text-sm min-[1100px]:text-tinta-lembut">
        <span>Nama</span>
        <span>Email</span>
        <span>Peran</span>
        <span>Status</span>
        <span>Saldo</span>
        <span>Detail</span>
      </div>
      {users.map((item) => (
        <article class="rounded-kartu border border-garis bg-kartu p-4 min-[1100px]:rounded-none min-[1100px]:border-x-0 min-[1100px]:border-t-0 min-[1100px]:border-b min-[1100px]:border-garis min-[1100px]:bg-transparent min-[1100px]:last:border-b-0">
          <div class="min-[1100px]:hidden">
            <a class="font-medium text-jalur hover:underline" href={`/admin/pengguna/${String(item.id)}`}>{item.name}</a>
            <p class="text-sm break-all text-tinta-lembut">{item.email}</p>
            <p class="mt-2 text-sm">Peran · {roleLabel(item.role)} · {statusLabel(item.status)}</p>
            <p class="text-sm tabular-nums">Saldo · {item.balance}</p>
            {item.deletionRequestedAt && (
              <p class="mt-1 text-xs font-medium text-bahaya">Minta hapus materi</p>
            )}
          </div>
          <div class="hidden min-[1100px]:grid min-[1100px]:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_5rem_5rem_5rem_auto] min-[1100px]:items-center min-[1100px]:gap-3 min-[1100px]:px-4 min-[1100px]:py-3">
            <p class="font-medium">{item.name}</p>
            <p class="min-w-0 break-all text-sm">{item.email}</p>
            <p class="text-sm">{roleLabel(item.role)}</p>
            <p class="text-sm">{statusLabel(item.status)}</p>
            <p class="text-sm tabular-nums">{item.balance}</p>
            <a class="text-sm text-jalur hover:underline" href={`/admin/pengguna/${String(item.id)}`}>Buka</a>
          </div>
        </article>
      ))}
    </div>
  )}

  <AdminPagination
    offset={offset}
    limit={limit}
    count={users.length}
    baseUrl="/admin/pengguna"
    extraParams={q ? { q } : {}}
  />
</AdminShell>
