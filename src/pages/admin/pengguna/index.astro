---
import { env } from 'cloudflare:workers';
import AdminPagination from '../../../components/AdminPagination.astro';
import AdminShell from '../../../components/AdminShell.astro';
import AdminAlert from '../../../components/admin/AdminAlert.astro';
import AdminBadge from '../../../components/admin/AdminBadge.astro';
import { isRecord } from '../../../domain/guard';
import {
  roleLabel,
  runAdminAction,
  statusLabel,
} from '../../../server/admin-actions';
import { listAdminUsers } from '../../../server/admin-data';
import { requireAdmin } from '../../../server/admin-guard';

const auth = await requireAdmin(Astro.request, { nav: true });
if ('redirect' in auth) return Astro.redirect(auth.redirect);

let message = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('csrf') ?? '') !== Astro.locals.csrf)
    message = 'Muat ulang halaman, lalu kirim lagi.';
  else
    message = await runAdminAction(Astro.request, env, Astro.locals.csrf, form);
}

const q = Astro.url.searchParams.get('q') ?? '';
const role = Astro.url.searchParams.get('role') ?? '';
const status = Astro.url.searchParams.get('status') ?? '';
const deletion = Astro.url.searchParams.get('deletion') === '1';
const offset = Number(Astro.url.searchParams.get('offset') ?? 0);
const limit = Number(Astro.url.searchParams.get('limit') ?? 20);
const params = new URLSearchParams({
  limit: String(limit),
  offset: String(offset),
});
if (q) params.set('q', q);
if (role) params.set('role', role);
if (status) params.set('status', status);
if (deletion) params.set('deletion', '1');

const listUrl = new URL('/admin/pengguna', Astro.url);
for (const [key, value] of params.entries())
  listUrl.searchParams.set(key, value);
const usersData = await listAdminUsers(auth.session.db, listUrl.toString());
const users = Array.isArray(usersData.users)
  ? usersData.users.filter(isRecord)
  : [];
const total =
  typeof usersData.total === 'number' ? usersData.total : users.length;
const extraParams: Record<string, string> = {};
if (q) extraParams.q = q;
if (role) extraParams.role = role;
if (status) extraParams.status = status;
if (deletion) extraParams.deletion = '1';

function roleTone(r: string) {
  return r === 'admin' ? 'brand' : 'neutral';
}
function statusTone(s: string) {
  return s === 'suspended' ? 'danger' : 'success';
}
---
<AdminShell title="Pengguna" section="pengguna" balance={auth.balance} superadmin={auth.superadmin} navStats={auth.nav}>
  <h1 class="judul">Pengguna</h1>
  <p class="mt-2 text-sm text-tinta-lembut">
    {total > 0 ? `${total} akun terdaftar` : 'Belum ada pengguna'}
  </p>
  {message && <AdminAlert message={message} tone="success" />}

  <form method="get" class="mt-6 grid gap-3 min-[900px]:grid-cols-[minmax(0,1fr)_auto_auto_auto_auto] min-[900px]:items-end">
    <label class="block text-sm">
      <span class="sr-only">Cari</span>
      <input
        class="min-h-11 w-full rounded-kontrol border border-garis bg-kartu px-3"
        name="q"
        type="search"
        value={q}
        placeholder="Cari nama atau email"
        autocomplete="off"
      />
    </label>
    <label class="block text-sm">
      <span class="font-medium">Peran</span>
      <select class="mt-1 min-h-11 w-full rounded-kontrol border border-garis bg-kartu px-2" name="role">
        <option value="">Semua</option>
        <option value="learner" selected={role === 'learner'}>Pelajar</option>
        <option value="admin" selected={role === 'admin'}>Admin</option>
      </select>
    </label>
    <label class="block text-sm">
      <span class="font-medium">Status</span>
      <select class="mt-1 min-h-11 w-full rounded-kontrol border border-garis bg-kartu px-2" name="status">
        <option value="">Semua</option>
        <option value="active" selected={status === 'active'}>Aktif</option>
        <option value="suspended" selected={status === 'suspended'}>Ditahan</option>
      </select>
    </label>
    <label class="flex min-h-11 items-center gap-2 rounded-kontrol border border-garis bg-kartu px-3 text-sm">
      <input type="checkbox" name="deletion" value="1" checked={deletion} />
      Minta hapus
    </label>
    <button class="min-h-11 rounded-kontrol bg-jalur px-4 text-sm font-medium text-white" type="submit">Terapkan</button>
  </form>

  {users.length === 0 && <p class="mt-6 text-tinta-lembut">Tidak ada pengguna untuk filter ini.</p>}
  {users.length > 0 && (
    <div class="mt-6 overflow-hidden rounded-kartu border border-garis bg-kartu">
      <div class="hidden min-[1100px]:grid min-[1100px]:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_5.5rem_5.5rem_4rem_auto] min-[1100px]:gap-3 min-[1100px]:border-b min-[1100px]:border-garis min-[1100px]:bg-kertas/50 min-[1100px]:px-4 min-[1100px]:py-2 min-[1100px]:text-xs min-[1100px]:font-medium min-[1100px]:text-tinta-lembut">
        <span>Nama</span>
        <span>Email</span>
        <span>Peran</span>
        <span>Status</span>
        <span>Saldo</span>
        <span></span>
      </div>
      <ul class="divide-y divide-garis">
        {users.map((item) => (
          <li class="px-4 py-3 min-[1100px]:grid min-[1100px]:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_5.5rem_5.5rem_4rem_auto] min-[1100px]:items-center min-[1100px]:gap-3">
            <div class="min-[1100px]:contents">
              <a class="font-medium text-jalur hover:underline" href={`/admin/pengguna/${String(item.id)}`}>{item.name}</a>
              <p class="min-w-0 break-all text-sm text-tinta-lembut min-[1100px]:text-tinta">{item.email}</p>
              <AdminBadge tone={roleTone(String(item.role))}>{roleLabel(item.role)}</AdminBadge>
              <AdminBadge tone={statusTone(String(item.status))}>{statusLabel(item.status)}</AdminBadge>
              <p class="text-sm tabular-nums">{item.balance}</p>
              <a class="text-sm text-jalur hover:underline min-[1100px]:text-right" href={`/admin/pengguna/${String(item.id)}`}>Buka</a>
              {item.deletionRequestedAt && (
                <p class="col-span-full mt-1 text-xs font-medium text-bahaya min-[1100px]:col-span-6">Minta hapus materi</p>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  )}

  <AdminPagination
    offset={offset}
    limit={limit}
    count={users.length}
    total={total}
    baseUrl="/admin/pengguna"
    extraParams={extraParams}
  />
</AdminShell>
