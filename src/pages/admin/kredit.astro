---
import { env } from 'cloudflare:workers';
import AdminPagination from '../../components/AdminPagination.astro';
import AdminShell from '../../components/AdminShell.astro';
import AdminBadge from '../../components/admin/AdminBadge.astro';
import {
  ledgerReasonLabels,
  orderStatusLabels,
} from '../../domain/admin-labels';
import { shortOrderId } from '../../domain/credit-ui';
import { formatIdr, formatWhenShort } from '../../domain/format';
import { isRecord } from '../../domain/guard';
import { listAdminLedger, listAdminOrders } from '../../server/admin-data';
import { requireAdmin } from '../../server/admin-guard';

const auth = await requireAdmin(Astro.request, { nav: true });
if ('redirect' in auth) return Astro.redirect(auth.redirect);

const tab = Astro.url.searchParams.get('tab') === 'buku' ? 'buku' : 'pesanan';
const limit = Number(Astro.url.searchParams.get('limit') ?? 20);
const offset = Number(Astro.url.searchParams.get('offset') ?? 0);
const orderStatus = Astro.url.searchParams.get('orderStatus') ?? '';

const ledgerParams = new URLSearchParams({
  limit: String(limit),
  offset: String(offset),
});
const ordersParams = new URLSearchParams({
  limit: String(limit),
  offset: String(offset),
});
if (orderStatus) ordersParams.set('orderStatus', orderStatus);

const ledgerListUrl = new URL('/admin/kredit', Astro.url);
ledgerListUrl.searchParams.set('tab', 'buku');
for (const [key, value] of ledgerParams.entries())
  ledgerListUrl.searchParams.set(key, value);
const ordersListUrl = new URL('/admin/kredit', Astro.url);
ordersListUrl.searchParams.set('tab', 'pesanan');
for (const [key, value] of ordersParams.entries())
  ordersListUrl.searchParams.set(key, value);

const ledgerData =
  tab === 'buku'
    ? await listAdminLedger(auth.session.db, ledgerListUrl.toString())
    : { entries: [], total: 0 };
const ordersData =
  tab === 'pesanan'
    ? await listAdminOrders(auth.session.db, ordersListUrl.toString())
    : { orders: [], total: 0 };
const entries = Array.isArray(ledgerData.entries)
  ? ledgerData.entries.filter(isRecord)
  : [];
const orders = Array.isArray(ordersData.orders)
  ? ordersData.orders.filter(isRecord)
  : [];
const ledgerTotal =
  typeof ledgerData.total === 'number' ? ledgerData.total : entries.length;
const ordersTotal =
  typeof ordersData.total === 'number' ? ordersData.total : orders.length;

function tabHref(next: 'pesanan' | 'buku') {
  const p = new URLSearchParams();
  p.set('tab', next);
  if (orderStatus && next === 'pesanan') p.set('orderStatus', orderStatus);
  return `/admin/kredit?${p}`;
}

function orderTone(status: string) {
  if (status === 'pending') return 'warning';
  if (status === 'paid') return 'success';
  if (status === 'failed') return 'danger';
  return 'neutral';
}

const exportOrdersParams = new URLSearchParams();
if (orderStatus) exportOrdersParams.set('orderStatus', orderStatus);
const ordersExportHref = exportOrdersParams.size
  ? `/api/admin/orders/export?${exportOrdersParams}`
  : '/api/admin/orders/export';
const ledgerExportHref = '/api/admin/ledger/export';
---
<AdminShell title="Kredit" section="kredit" balance={auth.balance} superadmin={auth.superadmin} navStats={auth.nav}>
  <div class="flex flex-col gap-3 min-[768px]:flex-row min-[768px]:items-end min-[768px]:justify-between">
    <div>
      <h1 class="judul">Kredit & pesanan</h1>
      <p class="mt-2 text-sm text-tinta-lembut">Buku besar global dan pesanan kredit.</p>
    </div>
    <a
      class="inline-flex min-h-10 items-center justify-center rounded-kontrol border border-garis bg-kartu px-4 text-sm font-medium text-tinta transition-colors hover:border-jalur/40 hover:bg-kertas"
      href={tab === 'buku' ? ledgerExportHref : ordersExportHref}
    >
      Unduh CSV
    </a>
  </div>

  <nav class="mt-6 flex flex-wrap gap-2" aria-label="Tab kredit">
    <a
      class:list={[
        'inline-flex min-h-10 items-center rounded-kontrol px-4 text-sm font-medium',
        tab === 'pesanan' ? 'bg-jalur-lembut text-jalur' : 'border border-garis text-tinta-lembut hover:bg-kartu',
      ]}
      href={tabHref('pesanan')}
    >
      Pesanan
    </a>
    <a
      class:list={[
        'inline-flex min-h-10 items-center rounded-kontrol px-4 text-sm font-medium',
        tab === 'buku' ? 'bg-jalur-lembut text-jalur' : 'border border-garis text-tinta-lembut hover:bg-kartu',
      ]}
      href={tabHref('buku')}
    >
      Buku besar
    </a>
  </nav>

  {tab === 'pesanan' && (
    <form class="mt-4 flex flex-wrap items-end gap-2" method="get" action="/admin/kredit">
      <input type="hidden" name="tab" value="pesanan" />
      <label class="text-sm">
        <span class="font-medium">Status</span>
        <select class="mt-1 min-h-10 rounded-kontrol border border-garis bg-kartu px-2" name="orderStatus">
          <option value="">Semua</option>
          {Object.entries(orderStatusLabels).map(([value, label]) => (
            <option value={value} selected={orderStatus === value}>{label}</option>
          ))}
        </select>
      </label>
      <button class="min-h-10 rounded-kontrol border border-garis bg-kartu px-4 text-sm" type="submit">Terapkan</button>
    </form>
  )}

  {tab === 'buku' && (
    entries.length === 0 ? (
      <p class="mt-6 text-sm text-tinta-lembut">Belum ada baris.</p>
    ) : (
      <div class="mt-6 overflow-hidden rounded-kartu border border-garis bg-kartu">
        <div class="hidden min-[900px]:grid min-[900px]:grid-cols-[7rem_minmax(0,1fr)_minmax(0,1.2fr)_5rem_auto] min-[900px]:gap-2 min-[900px]:border-b min-[900px]:border-garis min-[900px]:bg-kertas/50 min-[900px]:px-4 min-[900px]:py-2 min-[900px]:text-xs min-[900px]:font-medium min-[900px]:text-tinta-lembut">
          <span>Waktu</span>
          <span>Pengguna</span>
          <span>Alasan</span>
          <span>Jumlah</span>
          <span></span>
        </div>
        <ul class="divide-y divide-garis text-sm">
          {entries.map((entry) => {
            const amount = Number(entry.amount);
            return (
              <li class="grid gap-1 px-4 py-3 min-[900px]:grid-cols-[7rem_minmax(0,1fr)_minmax(0,1.2fr)_5rem_auto] min-[900px]:items-center min-[900px]:gap-2">
                <span class="text-xs text-tinta-lembut">{formatWhenShort(String(entry.createdAt ?? ''))}</span>
                <a class="font-medium text-jalur hover:underline truncate" href={`/admin/pengguna/${String(entry.userId)}`}>
                  {entry.userName}
                </a>
                <span class="truncate text-tinta-lembut">
                  {ledgerReasonLabels[String(entry.reason)] ?? entry.reason}
                  {entry.note && ` · ${entry.note}`}
                </span>
                <span class:list={['font-bold tabular-nums', amount >= 0 ? 'text-jalur' : 'text-bahaya']}>
                  {amount >= 0 ? '+' : ''}{amount}
                </span>
                <span class="hidden min-[900px]:block text-right text-xs text-tinta-lembut">{entry.userEmail}</span>
              </li>
            );
          })}
        </ul>
      </div>
    )
  )}

  {tab === 'pesanan' && (
    orders.length === 0 ? (
      <p class="mt-6 text-sm text-tinta-lembut">Belum ada pesanan.</p>
    ) : (
      <div class="mt-6 overflow-hidden rounded-kartu border border-garis bg-kartu">
        <ul class="divide-y divide-garis text-sm">
          {orders.map((order) => {
            const status = String(order.status);
            return (
              <li class="grid gap-2 px-4 py-3 min-[900px]:grid-cols-[7rem_auto_minmax(0,1fr)_5rem_5rem] min-[900px]:items-center min-[900px]:gap-3">
                <span class="text-xs text-tinta-lembut">{formatWhenShort(String(order.createdAt ?? ''))}</span>
                <AdminBadge tone={orderTone(status)}>{orderStatusLabels[status] ?? status}</AdminBadge>
                <div class="min-w-0">
                  <a class="font-medium text-jalur hover:underline" href={`/admin/pengguna/${String(order.userId)}`}>
                    {order.userEmail}
                  </a>
                  <p class="font-mono text-xs text-tinta-lembut">{shortOrderId(String(order.orderId ?? ''))}</p>
                </div>
                <span class="tabular-nums">{order.credits} kr</span>
                <span class="font-medium tabular-nums">{formatIdr(Number(order.amountIdr ?? 0))}</span>
              </li>
            );
          })}
        </ul>
      </div>
    )
  )}

  {tab === 'buku' && (
    <AdminPagination
      offset={offset}
      limit={limit}
      count={entries.length}
      total={ledgerTotal}
      baseUrl="/admin/kredit"
      extraParams={{ tab: 'buku' }}
    />
  )}
  {tab === 'pesanan' && (
    <AdminPagination
      offset={offset}
      limit={limit}
      count={orders.length}
      total={ordersTotal}
      baseUrl="/admin/kredit"
      extraParams={{
        tab: 'pesanan',
        ...(orderStatus ? { orderStatus } : {}),
      }}
    />
  )}
</AdminShell>
