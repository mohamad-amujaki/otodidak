---
import { env } from 'cloudflare:workers';
import AdminShell from '../../components/AdminShell.astro';
import AdminBadge from '../../components/admin/AdminBadge.astro';
import AdminStatCard from '../../components/admin/AdminStatCard.astro';
import AdminTrend7d from '../../components/admin/AdminTrend7d.astro';
import { aiTaskLabels, aiTasks } from '../../domain/admin-labels';
import { isRecord, record } from '../../domain/guard';
import {
  fetchAdminStats,
  fetchAdminTrend7d,
  listActiveModelsForTasks,
  listAdminUsers,
  listAllPacks,
} from '../../server/admin-data';
import { requireAdmin } from '../../server/admin-guard';

const bagian = Astro.url.searchParams.get('bagian');
const legacy: Record<string, string> = {
  pengguna: '/admin/pengguna',
  buku: '/admin/kredit',
  batas: '/admin/konfigurasi',
  prompt: '/admin/ai',
  model: '/admin/ai',
  paket: '/admin/paket',
};
if (bagian && legacy[bagian]) return Astro.redirect(legacy[bagian]);

const auth = await requireAdmin(Astro.request);
if ('redirect' in auth) return Astro.redirect(auth.redirect);

const stats = await fetchAdminStats(auth.session.db);
const trend7d = await fetchAdminTrend7d(auth.session.db);
const usersListUrl = new URL('/admin/pengguna', Astro.url);
usersListUrl.searchParams.set('limit', '5');
const { users: recentUsersRaw } = await listAdminUsers(
  auth.session.db,
  usersListUrl.toString(),
);
const recentUsers = recentUsersRaw.filter(isRecord);

const pendingOrders = Number(stats.pendingOrders ?? 0);
const jobsFailed = Number(stats.jobsFailed ?? 0);
const deletionRequests = Number(stats.deletionRequests ?? 0);
const navStats = {
  pendingOrders: Number(stats.pendingOrders ?? 0),
  jobsFailed: Number(stats.jobsFailed ?? 0),
  deletionRequests: Number(stats.deletionRequests ?? 0),
};

const actionItems = [
  pendingOrders > 0 && {
    label: `${pendingOrders} pesanan menunggu bayar`,
    href: '/admin/kredit?tab=pesanan&orderStatus=pending',
    tone: 'warning',
  },
  jobsFailed > 0 && {
    label: `${jobsFailed} job generasi gagal`,
    href: '/admin/antrean?jobStatus=failed',
    tone: 'danger',
  },
  deletionRequests > 0 && {
    label: `${deletionRequests} permintaan hapus data`,
    href: '/admin/pengguna?deletion=1',
    tone: 'danger',
  },
].filter(Boolean) as { label: string; href: string; tone: string }[];

const cards = [
  {
    label: 'Total pengguna',
    value: Number(stats.users ?? 0),
    href: '/admin/pengguna',
    tone: 'neutral',
  },
  {
    label: 'Baru (7 hari)',
    value: Number(stats.newUsers ?? 0),
    href: '/admin/pengguna',
    tone: 'neutral',
  },
  {
    label: 'Minta hapus data',
    value: deletionRequests,
    href: '/admin/pengguna?deletion=1',
    tone: deletionRequests > 0 ? 'danger' : 'neutral',
  },
  {
    label: 'Pesanan pending',
    value: pendingOrders,
    href: '/admin/kredit?tab=pesanan&orderStatus=pending',
    tone: pendingOrders > 0 ? 'warning' : 'neutral',
  },
  {
    label: 'Antrean aktif',
    value: Number(stats.jobsQueued ?? 0),
    href: '/admin/antrean',
    tone: 'neutral',
  },
  {
    label: 'Job gagal',
    value: jobsFailed,
    href: '/admin/antrean?jobStatus=failed',
    tone: jobsFailed > 0 ? 'danger' : 'neutral',
  },
] as const;

type PlatformModel = { task: string; label: string; modelName: string };

function userRoleTone(r: string) {
  return r === 'admin' ? 'brand' : 'neutral';
}
function userStatusTone(s: string) {
  return s === 'suspended' ? 'danger' : 'success';
}
let platformActivePacks = 0;
const platformModels: PlatformModel[] = [];
if (auth.superadmin) {
  const packs = await listAllPacks(auth.session.db);
  platformActivePacks = packs.filter((p) => p.active === 1).length;
  const modelByTask = await listActiveModelsForTasks(auth.session.db, [
    ...aiTasks,
  ]);
  for (const task of aiTasks) {
    const row = modelByTask.get(task);
    if (row) {
      platformModels.push({
        task,
        label: aiTaskLabels[task] ?? task,
        modelName: String(row.modelName ?? '—'),
      });
    }
  }
}
---
<AdminShell title="Admin" section="ringkasan" balance={auth.balance} superadmin={auth.superadmin} navStats={navStats} userName={String(auth.user.name)} userEmail={String(auth.user.email)}>
  <h1 class="judul">Ringkasan</h1>
  <p class="mt-2 text-sm text-tinta-lembut">Operasi platform Otodidak</p>

  {actionItems.length > 0 && (
    <section class="mt-8 rounded-kartu border border-hangat/30 bg-hangat-lembut/20 p-4" aria-label="Perlu tindakan">
      <h2 class="text-sm font-semibold text-tinta">Perlu tindakan</h2>
      <ul class="mt-3 space-y-2">
        {actionItems.map((item) => (
          <li>
            <a
              class:list={[
                'flex min-h-11 items-center justify-between gap-2 rounded-kontrol border bg-kartu px-3 text-sm font-medium transition-colors hover:bg-kertas',
                item.tone === 'danger' ? 'border-bahaya/30 text-bahaya' : 'border-hangat/30 text-hangat',
              ]}
              href={item.href}
            >
              {item.label}
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="mt-8 grid grid-cols-2 gap-3 md:gap-4 min-[1100px]:grid-cols-3">
    {cards.map((card) => (
      <AdminStatCard
        label={card.label}
        value={card.value}
        href={card.href}
        tone={card.tone}
      />
    ))}
  </div>

  <AdminTrend7d days={trend7d} />

  {auth.superadmin && platformModels.length > 0 && (
    <section class="mt-8 rounded-kartu border border-garis bg-kartu p-4" aria-label="Status platform">
      <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
        <div>
          <h2 class="text-sm font-semibold text-tinta">Platform</h2>
          <p class="mt-1 text-sm text-tinta-lembut">
            <span class="font-medium text-tinta tabular-nums">{platformActivePacks}</span> paket kredit aktif
          </p>
        </div>
        <div class="flex flex-wrap gap-2 text-sm">
          <a class="text-jalur hover:underline" href="/admin/paket">Paket</a>
          <span class="text-tinta-lembut" aria-hidden="true">·</span>
          <a class="text-jalur hover:underline" href="/admin/ai">AI</a>
        </div>
      </div>
      <ul class="mt-3 flex flex-wrap gap-2">
        {platformModels.map((item) => (
          <li>
            <a
              class="inline-flex max-w-full items-center gap-2 rounded-kontrol border border-garis bg-kertas px-3 py-1.5 text-xs hover:border-jalur/40"
              href={`/admin/ai?task=${item.task}`}
            >
              <span class="font-medium text-tinta">{item.label}</span>
              <span class="truncate font-mono text-tinta-lembut">{item.modelName}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {recentUsers.length > 0 && (
    <section class="mt-10">
      <h2 class="text-lg font-semibold text-tinta">Pengguna terbaru</h2>
      <ul class="mt-3 divide-y divide-garis overflow-hidden rounded-kartu border border-garis bg-kartu">
        {recentUsers.map((item) => (
          <li>
            <a
              class="flex flex-col gap-2 px-4 py-3 text-sm hover:bg-kertas/60 sm:flex-row sm:items-center sm:justify-between"
              href={`/admin/pengguna/${String(item.id)}`}
            >
              <span class="min-w-0">
                <span class="font-medium text-tinta">{item.name}</span>
                <span class="mt-0.5 block truncate text-tinta-lembut">{item.email}</span>
              </span>
              <span class="flex flex-wrap items-center gap-1.5">
                <AdminBadge tone={userRoleTone(String(item.role))}>
                  {String(item.role) === 'admin' ? 'Admin' : 'Pelajar'}
                </AdminBadge>
                <AdminBadge tone={userStatusTone(String(item.status))}>
                  {String(item.status) === 'suspended' ? 'Ditahan' : 'Aktif'}
                </AdminBadge>
                {item.deletionRequestedAt && (
                  <AdminBadge tone="danger">Minta hapus</AdminBadge>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-3">
        <a class="text-sm text-jalur hover:underline" href="/admin/pengguna">Lihat semua pengguna →</a>
      </p>
    </section>
  )}
</AdminShell>
