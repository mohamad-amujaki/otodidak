---
import { env } from 'cloudflare:workers';
import AdminShell from '../../components/AdminShell.astro';
import { configFieldHints, configFieldLabels } from '../../domain/admin-labels';
import { isRecord, record } from '../../domain/guard';
import { runAdminAction } from '../../server/admin-actions';
import { requireAdmin } from '../../server/admin-guard';
import { callApi } from '../../server/call';

const auth = await requireAdmin(Astro.request);
if ('redirect' in auth) return Astro.redirect(auth.redirect);

let message = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('csrf') ?? '') !== Astro.locals.csrf)
    message = 'Muat ulang halaman, lalu kirim lagi.';
  else message = await runAdminAction(Astro.request, env, Astro.locals.csrf, form);
}

const configResult = await callApi(Astro.request, env, '/api/admin/config');
const config = record(configResult.data);

const fields = [
  'maxChapters',
  'maxLessonsPerChapter',
  'quizQuestionCount',
  'quizPassPercent',
  'costRoadmap',
  'costLesson',
  'costQuiz',
  'signupCredits',
  'lessonMinuteLabel',
] as const;
---
<AdminShell title="Konfigurasi" section="konfigurasi" balance={auth.balance} superadmin={auth.superadmin}>
  <h1 class="judul">Konfigurasi produk</h1>
  <p class="mt-2 text-sm text-tinta-lembut">Batas dan biaya kredit untuk semua pengguna.</p>
  {message && <p class="mt-3 text-sm">{message}</p>}

  <form class="mt-8 grid max-w-lg gap-4" method="post">
    <input type="hidden" name="csrf" value={Astro.locals.csrf} />
    <input type="hidden" name="aksi" value="konfigurasi" />
    {fields.map((field) => (
      <label class="block text-sm">
        <span class="font-medium">{configFieldLabels[field]}</span>
        {configFieldHints[field] && (
          <span class="mt-0.5 block text-xs text-tinta-lembut">{configFieldHints[field]}</span>
        )}
        <input
          class="mt-2 min-h-11 w-full rounded-kontrol border border-garis px-3"
          name={field}
          type="number"
          value={String(config[field] ?? '')}
        />
      </label>
    ))}
    <button class="min-h-11 rounded-kontrol bg-jalur px-4 text-white w-fit" type="submit">Simpan</button>
  </form>
</AdminShell>
