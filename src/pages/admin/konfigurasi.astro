---
import { env } from 'cloudflare:workers';
import AdminShell from '../../components/AdminShell.astro';
import AdminAlert from '../../components/admin/AdminAlert.astro';
import {
  configFieldGroups,
  configFieldHints,
  configFieldLabels,
  configGroupTitles,
} from '../../domain/admin-labels';
import { isRecord, record } from '../../domain/guard';
import { loadConfig } from '../../server/account';
import { runAdminAction } from '../../server/admin-actions';
import { requireAdmin } from '../../server/admin-guard';

const auth = await requireAdmin(Astro.request, { nav: true });
if ('redirect' in auth) return Astro.redirect(auth.redirect);

let message = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('csrf') ?? '') !== Astro.locals.csrf)
    message = 'Muat ulang halaman, lalu kirim lagi.';
  else
    message = await runAdminAction(Astro.request, env, Astro.locals.csrf, form);
}

const config = record(await loadConfig(auth.session.db));
const groupKeys = Object.keys(
  configFieldGroups,
) as (keyof typeof configFieldGroups)[];
---
<AdminShell title="Konfigurasi" section="konfigurasi" balance={auth.balance} superadmin={auth.superadmin} navStats={auth.nav}>
  <h1 class="judul">Konfigurasi produk</h1>
  <p class="mt-2 text-sm text-tinta-lembut">Batas konten, biaya kredit, dan onboarding untuk semua pengguna.</p>
  {message && (
    <AdminAlert
      message={message}
      tone={/gagal|invalid|tidak valid/i.test(message) ? 'danger' : 'success'}
    />
  )}

  <form class="mt-8 grid gap-6 min-[900px]:grid-cols-2" method="post">
    <input type="hidden" name="csrf" value={Astro.locals.csrf} />
    <input type="hidden" name="aksi" value="konfigurasi" />
    {groupKeys.map((group) => (
      <section class="rounded-kartu border border-garis bg-kartu p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-tinta">{configGroupTitles[group]}</h2>
        <div class="mt-4 grid gap-4">
          {configFieldGroups[group].map((field) => (
            <label class="block text-sm">
              <span class="font-medium">{configFieldLabels[field]}</span>
              {configFieldHints[field] && (
                <span class="mt-0.5 block text-xs text-tinta-lembut">{configFieldHints[field]}</span>
              )}
              <input
                class="mt-2 min-h-11 w-full rounded-kontrol border border-garis px-3"
                name={field}
                type="number"
                value={String(config[field] ?? '')}
              />
            </label>
          ))}
        </div>
      </section>
    ))}
    <div class="min-[900px]:col-span-2">
      <button class="min-h-11 rounded-kontrol bg-jalur px-6 text-sm font-semibold text-white" type="submit">
        Simpan konfigurasi
      </button>
    </div>
  </form>
</AdminShell>
