---
import { env } from 'cloudflare:workers';
import AdminShell from '../../components/AdminShell.astro';
import AdminAlert from '../../components/admin/AdminAlert.astro';
import {
  configFieldGroups,
  configFieldHints,
  configFieldLabels,
  configGroupTitles,
} from '../../domain/admin-labels';
import { isRecord, record } from '../../domain/guard';
import { loadConfig } from '../../server/account';
import { runAdminAction } from '../../server/admin-actions';
import { requireAdmin } from '../../server/admin-guard';

const auth = await requireAdmin(Astro.request, { nav: true });
if ('redirect' in auth) return Astro.redirect(auth.redirect);

let message = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('csrf') ?? '') !== Astro.locals.csrf)
    message = 'Muat ulang halaman, lalu kirim lagi.';
  else
    message = await runAdminAction(Astro.request, env, Astro.locals.csrf, form);
}

const config = record(await loadConfig(auth.session.db));
const groupKeys = Object.keys(
  configFieldGroups,
) as (keyof typeof configFieldGroups)[];
---
<AdminShell title="Konfigurasi" section="konfigurasi" balance={auth.balance} superadmin={auth.superadmin} navStats={auth.nav} userName={String(auth.user.name)} userEmail={String(auth.user.email)}>
  <h1 class="judul">Konfigurasi produk</h1>
  <p class="mt-2 text-sm text-tinta-lembut">Batas konten, biaya kredit, dan onboarding untuk semua pengguna.</p>
  {message && (
    <AdminAlert
      message={message}
      tone={/gagal|invalid|tidak valid/i.test(message) ? 'danger' : 'success'}
    />
  )}

  <form class="mt-8 grid gap-6 min-[900px]:grid-cols-2" method="post">
    <input type="hidden" name="csrf" value={Astro.locals.csrf} />
    <input type="hidden" name="aksi" value="konfigurasi" />
    {groupKeys.map((group) => (
      <details open class="daftar rounded-kartu border border-garis bg-kartu shadow-sm">
        <summary class="px-5 py-3.5">
          <h2 class="text-lg font-semibold text-tinta">{configGroupTitles[group]}</h2>
          <svg class="size-4 shrink-0 text-tinta-lembut" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="grid gap-4 border-t border-garis px-5 pt-4 pb-5">
          {configFieldGroups[group].map((field) => (
            <label class="block text-sm">
              <span class="font-medium">{configFieldLabels[field]}</span>
              {configFieldHints[field] && (
                <span class="mt-0.5 block text-xs text-tinta-lembut">{configFieldHints[field]}</span>
              )}
              <input
                class="mt-2 min-h-11 w-full rounded-kontrol border border-garis px-3 tabular-nums"
                name={field}
                type="number"
                inputmode="numeric"
                value={String(config[field] ?? '')}
              />
            </label>
          ))}
        </div>
      </details>
    ))}
    <div class="sticky bottom-0 z-20 -mx-4 border-t border-garis bg-kertas px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] min-[900px]:static min-[900px]:col-span-2 min-[900px]:mx-0 min-[900px]:border-0 min-[900px]:bg-transparent min-[900px]:p-0">
      <button class="min-h-11 w-full rounded-kontrol bg-jalur px-6 text-sm font-semibold text-white min-[900px]:w-auto" type="submit">
        Simpan konfigurasi
      </button>
    </div>
  </form>
</AdminShell>
