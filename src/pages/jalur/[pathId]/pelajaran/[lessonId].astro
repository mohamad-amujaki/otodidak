---
import { env } from 'cloudflare:workers';
import Shell from '../../../../components/Shell.astro';
import { domainOf } from '../../../../domain/format';
import { isRecord, record } from '../../../../domain/guard';
import { renderLesson } from '../../../../domain/markdown';
import { callApi, errorOf } from '../../../../server/call';

const { pathId, lessonId } = Astro.params;
if (!pathId || !lessonId) return Astro.redirect('/dasbor');
const meResult = await callApi(Astro.request, env, '/api/me');
if (meResult.status !== 200) return Astro.redirect('/masuk');
const me = record(meResult.data);
const user = record(me.user);
const config = record(me.config);
let message = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('csrf') ?? '') !== Astro.locals.csrf)
    message = 'Muat ulang halaman, lalu kirim lagi.';
  else {
    const action = String(form.get('aksi') ?? '');
    const path =
      action === 'selesai'
        ? `/api/lessons/${lessonId}/complete`
        : `/api/lessons/${lessonId}/open`;
    const result = await callApi(Astro.request, env, path, {
      method: 'POST',
      json: {},
      csrf: Astro.locals.csrf,
    });
    const error = errorOf(result.data);
    if (error && error.code !== 'generation_in_progress')
      message = error.message;
  }
}
const contentResult = await callApi(
  Astro.request,
  env,
  `/api/lessons/${lessonId}`,
);
if (contentResult.status === 404) return Astro.redirect(`/jalur/${pathId}`);
const lesson = record(contentResult.data);
const claims = Array.isArray(lesson.claims)
  ? lesson.claims.filter(isRecord)
  : [];
const sources = Array.isArray(lesson.sources)
  ? lesson.sources.filter(isRecord)
  : [];
const html =
  typeof lesson.body === 'string'
    ? renderLesson(
        lesson.body,
        claims.map((claim) => ({
          quote: String(claim.quote ?? ''),
          unsourced: claim.unsourced === true,
        })),
      )
    : '';
const cost = typeof config.costLesson === 'number' ? config.costLesson : 3;
const minutes =
  typeof config.lessonMinuteLabel === 'number' ? config.lessonMinuteLabel : 15;
---
<Shell title={String(lesson.title ?? 'Pelajaran')} balance={typeof me.balance === 'number' ? me.balance : 0} role={user.role === 'admin' ? 'admin' : 'learner'} suspended={user.status === 'suspended'}>
  <p class="text-sm text-tinta-lembut"><a href={`/jalur/${pathId}`}>Kembali ke jalur</a></p>
  <h1 class="mt-2 text-[1.75rem] leading-[1.25]">{lesson.title}</h1>
  <p class="text-sm text-tinta-lembut">Sekitar {minutes} menit</p>
  {message && <p class="mt-3 text-sm text-bahaya">{message}</p>}
  {lesson.status === 'queued' && <p class="mt-4">Menyusun pelajaran.</p>}
  {!html && lesson.status !== 'queued' && (
    <form class="mt-6" method="post">
      <input type="hidden" name="csrf" value={Astro.locals.csrf} />
      <input type="hidden" name="aksi" value="buka" />
      <button class="inline-flex min-h-11 items-center rounded-kontrol bg-jalur px-4 text-white" type="submit">Buat pelajaran</button>
      <p class="mt-2 text-sm text-tinta-lembut">Memakai {cost} kredit. Membaca ulang tidak mengurangi kredit.</p>
    </form>
  )}
  {html && (
    <>
      <article class="baca mt-6 max-w-3xl font-serif text-lg leading-8" set:html={html}></article>
      <section class="mt-8">
        <h2 class="text-xl">Sumber</h2>
        {sources.length === 0 ? <p class="mt-2 text-sm text-tinta-lembut">Belum ada sumber yang tersimpan.</p> : (
          <ul class="mt-2 space-y-2">
            {sources.map((source) => (
              <li>
                <a class="text-jalur" href={String(source.url)}>{source.title}</a>
                <span class="text-sm text-tinta-lembut"> {domainOf(String(source.url))}</span>
              </li>
            ))}
          </ul>
        )}
      </section>
      {lesson.completedAt ? <p class="mt-6 text-sm text-jalur">Pelajaran ini sudah ditandai selesai.</p> : (
        <form class="mt-6" method="post">
          <input type="hidden" name="csrf" value={Astro.locals.csrf} />
          <input type="hidden" name="aksi" value="selesai" />
          <button class="inline-flex min-h-11 items-center rounded-kontrol bg-jalur px-4 text-white" type="submit">Tandai selesai</button>
        </form>
      )}
    </>
  )}
  {lesson.status === 'queued' && <meta http-equiv="refresh" content="4" />}
</Shell>
