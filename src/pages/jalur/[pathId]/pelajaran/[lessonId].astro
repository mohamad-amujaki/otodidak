---
import { env } from 'cloudflare:workers';
import ChapterNav from '../../../../components/ChapterNav.astro';
import Shell from '../../../../components/Shell.astro';
import { AppError } from '../../../../domain/errors';
import { domainOf } from '../../../../domain/format';
import { isRecord, record } from '../../../../domain/guard';
import { renderLesson } from '../../../../domain/markdown';
import { openLesson } from '../../../../server/generation';
import {
  completeLesson,
  lessonForUser,
} from '../../../../server/lesson-actions';
import { pathDetail } from '../../../../server/read';
import { pageMe } from '../../../../server/ssr';

const { pathId, lessonId } = Astro.params;
if (!pathId || !lessonId) return Astro.redirect('/dasbor');
const page = await pageMe(Astro.request, env);
if ('redirect' in page) return Astro.redirect(page.redirect);
const { session, me: meRaw } = page;
const me = record(meRaw);
const user = record(me.user);
const config = record(me.config);
let message = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('csrf') ?? '') !== Astro.locals.csrf)
    message = 'Muat ulang halaman, lalu kirim lagi.';
  else {
    const action = String(form.get('aksi') ?? '');
    try {
      if (action === 'selesai')
        await completeLesson(session.db, session.user, lessonId);
      else await openLesson(env, Astro.request, session.user, lessonId);
    } catch (error) {
      if (
        error instanceof AppError &&
        error.code === 'generation_in_progress'
      ) {
        /* tetap menunggu */
      } else {
        message =
          error instanceof AppError ? error.message : 'Permintaan gagal.';
      }
    }
  }
}
let lessonRaw: Record<string, unknown>;
try {
  lessonRaw = await lessonForUser(session.db, session.user.id, lessonId);
} catch (error) {
  if (error instanceof AppError && error.code === 'not_found')
    return Astro.redirect(`/jalur/${pathId}`);
  throw error;
}
const lesson = record(lessonRaw);
const claims = Array.isArray(lesson.claims)
  ? lesson.claims.filter(isRecord)
  : [];
const sources = Array.isArray(lesson.sources)
  ? lesson.sources.filter(isRecord)
  : [];
const html =
  typeof lesson.body === 'string'
    ? renderLesson(
        lesson.body,
        claims.map((claim) => ({
          quote: String(claim.quote ?? ''),
          unsourced: claim.unsourced === true,
        })),
      )
    : '';
const cost = typeof config.costLesson === 'number' ? config.costLesson : 3;
const minutes =
  typeof config.lessonMinuteLabel === 'number' ? config.lessonMinuteLabel : 15;
const pathRaw = await pathDetail(session.db, session.user.id, pathId);
const outlineChapters =
  pathRaw && Array.isArray(pathRaw.chapters)
    ? pathRaw.chapters.filter(isRecord)
    : [];
const navChapters = outlineChapters.map((chapter) => ({
  id: String(chapter.id),
  title: String(chapter.title ?? 'Bab'),
  lessons: (Array.isArray(chapter.lessons)
    ? chapter.lessons.filter(isRecord)
    : []
  ).map((item) => ({
    id: String(item.id),
    title: String(item.title ?? 'Pelajaran'),
  })),
}));
---
<Shell title={String(lesson.title ?? 'Pelajaran')} balance={typeof me.balance === 'number' ? me.balance : 0} role={user.role === 'admin' ? 'admin' : 'learner'} suspended={user.status === 'suspended'}>
  <p><a class="inline-flex min-h-11 items-center text-sm text-tinta-lembut" href={`/jalur/${pathId}`}>Kembali ke jalur</a></p>
  <h1 class="judul mt-2">{lesson.title}</h1>
  <p class="text-sm leading-[1.4] text-tinta-lembut">Sekitar {minutes} menit</p>
  {message && <p class="mt-3 text-sm text-bahaya">{message}</p>}
  <div class:list={["mt-6", navChapters.length > 0 && "min-[1100px]:grid min-[1100px]:grid-cols-[280px_minmax(0,1fr)] min-[1100px]:items-start min-[1100px]:gap-8"]}>
    {navChapters.length > 0 && <ChapterNav pathId={pathId} chapters={navChapters} currentLessonId={lessonId} />}
    <div class="min-w-0">
      {lesson.status === 'queued' && <p>Menyusun pelajaran.</p>}
      {!html && lesson.status !== 'queued' && (
        <form method="post">
          <input type="hidden" name="csrf" value={Astro.locals.csrf} />
          <input type="hidden" name="aksi" value="buka" />
          <button class="w-full rounded-kontrol bg-jalur px-4 text-white min-[768px]:w-auto" type="submit">Buat pelajaran</button>
          <p class="mt-2 text-sm leading-[1.4] text-tinta-lembut">Memakai {cost} kredit. Membaca ulang tidak mengurangi kredit.</p>
        </form>
      )}
      {html && (
        <div class="max-w-[65ch]">
          <!-- Reading Progress Bar -->
          <div class="sticky top-[3.25rem] z-10 -mx-4 px-4 -mt-4 mb-6">
            <div class="h-1 w-full bg-garis rounded-full overflow-hidden">
              <div 
                id="reading-progress"
                class="h-full bg-jalur transition-all"
                style="width: 0%"
              ></div>
            </div>
          </div>

          <article class="baca" set:html={html} id="lesson-content"></article>
          
          <!-- Academic-Style References Section -->
          <section class="mt-12 border-t-2 border-garis pt-8">
            <h2 class="mb-6 text-xs font-semibold uppercase tracking-wider text-tinta-lembut">
              Referensi
            </h2>
            
            {sources.length === 0 ? (
              <p class="text-sm text-tinta-lembut italic">
                Belum ada sumber yang tersimpan
              </p>
            ) : (
              <ol class="space-y-3">
                {sources.map((source, index) => (
                  <li class="group flex gap-3 text-sm leading-relaxed">
                    <span class="shrink-0 text-tinta-lembut font-mono text-xs">
                      [{index + 1}]
                    </span>
                    <div class="min-w-0 flex-1">
                      <a 
                        href={String(source.url)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-tinta hover:text-jalur hover:underline decoration-jalur/50 break-words inline transition-colors"
                      >
                        {source.title}
                      </a>
                      <span class="text-tinta-lembut">
                        {' '}· {domainOf(String(source.url))}
                      </span>
                      <svg class="inline-block size-3 ml-1 text-tinta-lembut group-hover:text-jalur transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </div>
                  </li>
                ))}
              </ol>
            )}
          </section>
          
          {lesson.completedAt ? (
            <div class="mt-6 rounded-lg border border-jalur/30 bg-jalur-lembut p-4">
              <div class="flex items-center gap-2">
                <svg class="size-5 text-jalur" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <p class="text-sm font-medium text-jalur">Pelajaran ini sudah ditandai selesai</p>
              </div>
            </div>
          ) : (
            <form class="mt-6" method="post" id="complete-form">
              <input type="hidden" name="csrf" value={Astro.locals.csrf} />
              <input type="hidden" name="aksi" value="selesai" />
              <button 
                class="w-full min-h-11 rounded-kontrol bg-jalur px-6 font-semibold text-white shadow-md transition-all hover:shadow-lg hover:brightness-110 min-[768px]:w-auto" 
                type="submit"
              >
                Tandai Selesai
              </button>
            </form>
          )}

          <!-- Keyboard Shortcuts Hint -->
          <div class="mt-8 rounded-lg border border-garis bg-kertas p-4">
            <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-tinta-lembut">Pintasan Keyboard</p>
            <div class="grid gap-2 text-sm min-[768px]:grid-cols-2">
              <div class="flex items-center gap-2">
                <kbd class="rounded border border-garis bg-white px-2 py-1 text-xs font-semibold">←</kbd>
                <span class="text-tinta-lembut">Kembali</span>
              </div>
              <div class="flex items-center gap-2">
                <kbd class="rounded border border-garis bg-white px-2 py-1 text-xs font-semibold">Esc</kbd>
                <span class="text-tinta-lembut">Ke jalur</span>
              </div>
              {!lesson.completedAt && (
                <div class="flex items-center gap-2">
                  <kbd class="rounded border border-garis bg-white px-2 py-1 text-xs font-semibold">Ctrl+Enter</kbd>
                  <span class="text-tinta-lembut">Tandai selesai</span>
                </div>
              )}
            </div>
          </div>
        </div>
      )}
      
      {/* Reading Progress & Keyboard Shortcuts Script */}
      {html && (
        <script>
          // Reading progress
          const progressBar = document.getElementById('reading-progress');
          const content = document.getElementById('lesson-content');
          
          if (progressBar && content) {
            function updateProgress() {
              const contentRect = content.getBoundingClientRect();
              const windowHeight = window.innerHeight;
              const contentHeight = content.offsetHeight;
              const scrolled = Math.max(0, -contentRect.top);
              const progress = Math.min(100, (scrolled / (contentHeight - windowHeight)) * 100);
              progressBar.style.width = progress + '%';
            }
            
            window.addEventListener('scroll', updateProgress);
            updateProgress();
          }

          // Keyboard shortcuts
          document.addEventListener('keydown', (e) => {
            // Don't trigger shortcuts when typing in inputs
            if (e.target.matches('input, textarea')) return;
            
            // Ctrl/Cmd + Enter = Mark complete (if not already completed)
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
              e.preventDefault();
              const completeForm = document.getElementById('complete-form');
              if (completeForm) completeForm.submit();
            }
            
            // Left arrow = Previous lesson/page
            if (e.key === 'ArrowLeft') {
              e.preventDefault();
              window.history.back();
            }
            
            // Escape = Go back to path
            if (e.key === 'Escape') {
              e.preventDefault();
              const backLink = document.querySelector('a[href^="/jalur/"]');
              if (backLink) backLink.click();
            }
          });
        </script>
      )}
    </div>
  </div>
  {lesson.status === 'queued' && <meta http-equiv="refresh" content="4" />}
</Shell>
