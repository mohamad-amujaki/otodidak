---
import { env } from 'cloudflare:workers';
import Shell from '../../../../components/Shell.astro';
import { isRecord, record } from '../../../../domain/guard';
import { callApi, errorOf } from '../../../../server/call';

const { pathId, chapterId } = Astro.params;
if (!pathId || !chapterId) return Astro.redirect('/dasbor');
const meResult = await callApi(Astro.request, env, '/api/me');
if (meResult.status !== 200) return Astro.redirect('/masuk');
const me = record(meResult.data);
const user = record(me.user);
const config = record(me.config);
let message = '';
let result: Record<string, unknown> | null = null;
const pathResult = await callApi(Astro.request, env, `/api/paths/${pathId}`);
const detail = record(pathResult.data);
const chapters = Array.isArray(detail.chapters)
  ? detail.chapters.filter(isRecord)
  : [];
const chapter = chapters.find((item) => item.id === chapterId) ?? null;
const quiz = chapter && isRecord(chapter.quiz) ? chapter.quiz : null;
const questions =
  quiz && Array.isArray(quiz.questions) ? quiz.questions.filter(isRecord) : [];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('csrf') ?? '') !== Astro.locals.csrf)
    message = 'Muat ulang halaman, lalu kirim lagi.';
  else if (String(form.get('aksi') ?? '') === 'ulang' && quiz) {
    const created = await callApi(
      Astro.request,
      env,
      `/api/chapters/${chapterId}/quiz`,
      { method: 'POST', json: {}, csrf: Astro.locals.csrf },
    );
    const error = errorOf(created.data);
    message = error ? error.message : 'Menyusun kuis.';
  } else if (quiz) {
    const answers = questions.map((_, index) =>
      Number(form.get(`jawaban-${index}`)),
    );
    const submitted = await callApi(
      Astro.request,
      env,
      `/api/quizzes/${String(quiz.id)}/attempts`,
      { method: 'POST', json: { answers }, csrf: Astro.locals.csrf },
    );
    const error = errorOf(submitted.data);
    if (error) message = error.message;
    else if (isRecord(submitted.data)) result = submitted.data;
  }
}
const cost = typeof config.costQuiz === 'number' ? config.costQuiz : 1;
const pass =
  typeof config.passThreshold === 'number' ? config.passThreshold : 80;
const explanations =
  result && Array.isArray(result.review)
    ? result.review.filter(
        (item) => isRecord(item) && typeof item.explanation === 'string',
      )
    : [];
---
<Shell title="Kuis" balance={typeof me.balance === 'number' ? me.balance : 0} role={user.role === 'admin' ? 'admin' : 'learner'} suspended={user.status === 'suspended'}>
  <p class="text-sm"><a href={`/jalur/${pathId}`}>Kembali ke jalur</a></p>
  <h1 class="mt-2 text-[1.75rem] leading-[1.25]">{chapter ? chapter.title : 'Kuis'}</h1>
  {message && <p class="mt-3 text-sm text-bahaya">{message}</p>}
  {!quiz && <p class="mt-4">Kuis belum disusun.</p>}
  {quiz && questions.length === 0 && <p class="mt-4">Menyusun kuis.</p>}
  {result && (
    <p class="mt-4 text-lg tabular-nums">{String(result.scorePercent)} dari 100. Batas paham {pass}.</p>
  )}
  {quiz && questions.length > 0 && (
    <form class="mt-6 space-y-5" method="post">
      <input type="hidden" name="csrf" value={Astro.locals.csrf} />
      {questions.map((question, index) => {
        const choices = Array.isArray(question.choices) ? question.choices : [];
        return (
          <fieldset class="space-y-2">
            <legend>{index + 1}. {question.stem}</legend>
            {choices.map((choice, choiceIndex) => (
              <label class="flex min-h-11 items-center gap-2">
                <input type="radio" name={`jawaban-${index}`} value={choiceIndex} required />
                <span>{choice}</span>
              </label>
            ))}
          </fieldset>
        );
      })}
      <button class="inline-flex min-h-11 items-center rounded-kontrol bg-jalur px-4 text-white" type="submit">Kirim jawaban</button>
      <p class="text-sm text-tinta-lembut">Mengulang jawaban yang sama tidak memakai kredit.</p>
    </form>
  )}
  {explanations.length > 0 && (
    <section class="mt-6 space-y-3">
      <h2 class="text-xl">Yang perlu dicek</h2>
      {explanations.map((item) => (
        <p>{item.explanation}</p>
      ))}
    </section>
  )}
  {quiz && (
    <form class="mt-6" method="post">
      <input type="hidden" name="csrf" value={Astro.locals.csrf} />
      <input type="hidden" name="aksi" value="ulang" />
      <button class="inline-flex min-h-11 items-center rounded-kontrol border border-garis px-3" type="submit">Susun kuis baru</button>
      <p class="text-sm text-tinta-lembut">Memakai {cost} kredit</p>
    </form>
  )}
  {quiz && questions.length === 0 && <meta http-equiv="refresh" content="4" />}
</Shell>
