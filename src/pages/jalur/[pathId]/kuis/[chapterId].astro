---
import { env } from 'cloudflare:workers';
import Shell from '../../../../components/Shell.astro';
import { AppError } from '../../../../domain/errors';
import { quizStatusLabel } from '../../../../domain/format';
import { isRecord, record } from '../../../../domain/guard';
import { startQuiz } from '../../../../server/generation';
import { submitQuizAttempt } from '../../../../server/quiz-actions';
import { pathDetail } from '../../../../server/read';
import { pageMe } from '../../../../server/ssr';

const { pathId, chapterId } = Astro.params;
if (!pathId || !chapterId) return Astro.redirect('/dasbor');
const page = await pageMe(Astro.request, env);
if ('redirect' in page) return Astro.redirect(page.redirect);
const { session, me: meRaw } = page;
const me = record(meRaw);
const user = record(me.user);
const config = record(me.config);
let message = '';
let result: Record<string, unknown> | null = null;
const pathRaw = await pathDetail(session.db, session.user.id, pathId);
if (!pathRaw) return Astro.redirect('/pustaka');
const detail = record(pathRaw);
const chapters = Array.isArray(detail.chapters)
  ? detail.chapters.filter(isRecord)
  : [];
const chapter = chapters.find((item) => item.id === chapterId) ?? null;
const quiz = chapter && isRecord(chapter.quiz) ? chapter.quiz : null;
const questions =
  quiz && Array.isArray(quiz.questions) ? quiz.questions.filter(isRecord) : [];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('csrf') ?? '') !== Astro.locals.csrf)
    message = 'Muat ulang halaman, lalu kirim lagi.';
  else if (String(form.get('aksi') ?? '') === 'ulang' && quiz) {
    try {
      await startQuiz(env, Astro.request, session.user, chapterId);
      message = 'Menyusun kuis.';
    } catch (error) {
      message =
        error instanceof AppError ? error.message : 'Gagal memulai kuis.';
    }
  } else if (quiz) {
    const answers = questions.map((_, index) =>
      Number(form.get(`jawaban-${index}`)),
    );
    try {
      const submitted = await submitQuizAttempt(
        session.db,
        session.user,
        String(quiz.id),
        answers,
      );
      result = submitted;
    } catch (error) {
      message =
        error instanceof AppError ? error.message : 'Gagal mengirim jawaban.';
    }
  }
}
const cost = typeof config.costQuiz === 'number' ? config.costQuiz : 1;
const pass =
  typeof config.passThreshold === 'number' ? config.passThreshold : 80;
const explanations =
  result && Array.isArray(result.review)
    ? result.review.filter(
        (item) => isRecord(item) && typeof item.explanation === 'string',
      )
    : [];
const outcome =
  result?.quizStatus === 'understood' || result?.quizStatus === 'retry'
    ? result.quizStatus
    : null;
---
<Shell title="Kuis" balance={typeof me.balance === 'number' ? me.balance : 0} role={user.role === 'admin' ? 'admin' : 'learner'} suspended={user.status === 'suspended'}>
  <div class="max-w-[65ch]">
    <p><a class="inline-flex min-h-11 items-center text-sm text-tinta-lembut" href={`/jalur/${pathId}`}>Kembali ke jalur</a></p>
    <h1 class="judul mt-2">{chapter ? chapter.title : 'Kuis'}</h1>
    {message && <p class="mt-3 text-sm text-bahaya">{message}</p>}
    {!quiz && <p class="mt-4">Kuis belum disusun.</p>}
    {quiz && questions.length === 0 && <p class="mt-4">Menyusun kuis.</p>}
    {result && (
      <div class="mt-4">
        {outcome && <p class="text-lg">{quizStatusLabel(outcome)}</p>}
        <p class="text-sm leading-[1.4] text-tinta-lembut">Pelajaran berikutnya tetap terbuka.</p>
        <p class="mt-1 tabular-nums">{String(result.scorePercent)} dari 100. Batas paham {pass}.</p>
      </div>
    )}
    {quiz && questions.length > 0 && (
      <form class="mt-6 space-y-5" method="post" data-kuis>
        <input type="hidden" name="csrf" value={Astro.locals.csrf} />
        {questions.map((question, index) => {
          const choices = Array.isArray(question.choices) ? question.choices : [];
          return (
            <fieldset class="grid gap-2">
              <legend class="text-base" tabindex="-1">{index + 1}. {question.stem}</legend>
              {choices.map((choice, choiceIndex) => (
                <label class="w-full cursor-pointer rounded-kontrol border border-garis bg-kartu px-3 has-checked:border-jalur has-checked:bg-jalur-lembut">
                  <input type="radio" name={`jawaban-${index}`} value={choiceIndex} required />
                  <span>{choice}</span>
                </label>
              ))}
            </fieldset>
          );
        })}
        {questions.length > 1 && !result && (
          <button class="w-full rounded-kontrol border border-garis bg-kartu min-[768px]:w-auto" type="button" data-lanjut hidden>Berikutnya</button>
        )}
        <button class="w-full rounded-kontrol bg-jalur px-4 text-white min-[768px]:w-auto" type="submit" data-kirim>Kirim jawaban</button>
        <p class="text-sm leading-[1.4] text-tinta-lembut">Mengulang jawaban yang sama tidak memakai kredit.</p>
      </form>
    )}
    {quiz && questions.length > 1 && !result && (
      <script is:inline>
        (function () {
          var form = document.querySelector("[data-kuis]");
          if (!form) return;
          var sets = Array.prototype.filter.call(form.querySelectorAll("fieldset"), function (node) {
            return node instanceof HTMLFieldSetElement;
          });
          if (sets.length < 2) return;
          var next = form.querySelector("[data-lanjut]");
          var send = form.querySelector("[data-kirim]");
          var index = 0;
          function paint() {
            sets.forEach(function (set, item) {
              set.hidden = item !== index;
            });
            if (next) next.hidden = index >= sets.length - 1;
            if (send) send.hidden = index < sets.length - 1;
          }
          if (next) {
            next.addEventListener("click", function () {
              var picked = sets[index].querySelector("input:checked");
              if (!picked) {
                var first = sets[index].querySelector("input");
                if (first) first.focus();
                return;
              }
              index += 1;
              paint();
              var legend = sets[index] && sets[index].querySelector("legend");
              if (legend) legend.focus();
            });
          }
          paint();
        })();
      </script>
    )}
    {explanations.length > 0 && (
      <section class="mt-6 space-y-3">
        <h2 class="text-xl">Yang perlu dicek</h2>
        {explanations.map((item) => (
          <p>{item.explanation}</p>
        ))}
      </section>
    )}
    {quiz && (
      <form class="mt-6" method="post">
        <input type="hidden" name="csrf" value={Astro.locals.csrf} />
        <input type="hidden" name="aksi" value="ulang" />
        <button class="w-full rounded-kontrol border border-garis bg-kartu min-[768px]:w-auto" type="submit">Susun kuis baru</button>
        <p class="mt-2 text-sm leading-[1.4] text-tinta-lembut">Memakai {cost} kredit</p>
      </form>
    )}
  </div>
  {quiz && questions.length === 0 && <meta http-equiv="refresh" content="4" />}
</Shell>
