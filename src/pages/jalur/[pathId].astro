                  {!lessonAffordable && (
                    <p class="flex items-center text-xs tabular-nums text-tinta-lembut">
                      <span>{creditShortNote(balance, lessonCost)}</span>
                      <a class="ml-2 font-semibold text-jalur hover:underline" href={lessonTopUpHref}>
                        Isi kredit
                      </a>
                    </p>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>

        {isReady && (
          <section class="mt-6 border-t border-garis pt-5">
            <h3 class="text-[11px] font-bold uppercase tracking-[0.08em] text-tinta-lembut">Judul jalur</h3>
            <form class="mt-2" method="post">
              <input type="hidden" name="csrf" value={Astro.locals.csrf} />
              <input type="hidden" name="tinjau" value="1" />
              <input type="hidden" name="aksi" value="judul" />
              <label class="sr-only" for="tinjau-judul-jalur">Judul jalur</label>
              <div class="flex flex-wrap items-center gap-2">
                <input class="min-h-10 min-w-0 flex-1 rounded-kontrol border border-garis bg-kartu px-3 text-sm" id="tinjau-judul-jalur" name="title" value={String(detail.title ?? '')} />
                <button class="min-h-10 rounded-kontrol border border-garis bg-kartu px-3 text-sm font-medium transition-colors hover:bg-kertas" type="submit">Simpan judul</button>
              </div>
            </form>
          </section>
        )}
      </div>

      <footer class="flex shrink-0 flex-col gap-3 border-t border-garis bg-kartu px-5 py-3 min-[640px]:px-6 min-[640px]:py-4">
        {isReady && !isActive && (
          <label class="flex cursor-pointer items-start gap-2 text-sm text-tinta">
            <input class="mt-1 size-4 rounded border-garis text-jalur" type="checkbox" id="konfirmasi-tinjau" />
            <span>Saya sudah meninjau jalur ini</span>
          </label>
        )}
        <div class="flex flex-wrap items-center justify-end gap-2">
          <p class="mr-auto hidden text-xs text-tinta-lembut min-[640px]:block">Perubahan langsung diterapkan ke jalur ini.</p>
          <button class="min-h-10 rounded-kontrol border border-garis bg-kartu px-4 text-sm font-medium text-tinta transition-colors hover:bg-kertas" type="button" data-close-tinjau>Nanti dulu</button>
          {isReady && !isActive && (
            <form class="w-full min-[640px]:w-auto" method="post" id="setujui-jalur-form">
              <input type="hidden" name="csrf" value={Astro.locals.csrf} />
              <input type="hidden" name="aksi" value="aktif" />
              <button class="min-h-10 w-full rounded-kontrol bg-tinta px-4 text-sm font-semibold text-white transition-all hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-40" type="submit" id="setujui-jalur-btn" disabled>Setujui & buat</button>
            </form>
          )}
          {isReady && isActive && (
            <button class="min-h-10 rounded-kontrol bg-tinta px-4 text-sm font-semibold text-white transition-all hover:brightness-110" type="button" data-close-tinjau>Selesai meninjau</button>
          )}
        </div>
      </footer>
    </div>
  </dialog>

  <script>
    const sheet = document.getElementById('tinjau-sheet');
    if (sheet instanceof HTMLDialogElement) {
      const scroller = sheet.querySelector('[data-tinjau-scroll]');
      const openers = document.querySelectorAll('[data-open-tinjau]');
      for (const opener of openers) {
        opener.addEventListener('click', () => sheet.showModal());
      }
      const closers = sheet.querySelectorAll('[data-close-tinjau]');
      for (const closer of closers) {
        closer.addEventListener('click', () => sheet.close());
      }
      sheet.addEventListener('click', (event) => {
        if (event.target === sheet) sheet.close();
      });
      for (const form of sheet.querySelectorAll('form')) {
        form.addEventListener('submit', () => {
          if (!(scroller instanceof HTMLElement)) return;
          try {
            sessionStorage.setItem('tinjau-scroll', String(scroller.scrollTop));
          } catch {
            // Storage can be unavailable; the sheet still works without it.
          }
        });
      }
      const confirm = document.getElementById('konfirmasi-tinjau');
      const approve = document.getElementById('setujui-jalur-btn');
      if (confirm instanceof HTMLInputElement && approve instanceof HTMLButtonElement) {
        const sync = () => {
          approve.disabled = !confirm.checked;
        };
        confirm.addEventListener('change', sync);
        sync();
      }
      if (sheet.dataset.open === 'true') {
        sheet.showModal();
        if (scroller instanceof HTMLElement) {
          try {
            const saved = sessionStorage.getItem('tinjau-scroll');
            if (saved !== null) {
              scroller.scrollTop = Number(saved);
              sessionStorage.removeItem('tinjau-scroll');
            }
          } catch {
            // Ignore storage failures.
          }
        }
      }
    }
  </script>

  {!isReady && (
    <script define:vars={{ pathId }}>
      const timer = setInterval(async () => {
        try {
          const response = await fetch(`/api/paths/${pathId}`, {
            headers: { accept: 'application/json' },
          });
          if (!response.ok) return;
          const data = await response.json();
          if (data.status && data.status !== 'draft') {
            clearInterval(timer);
            const keepTinjau = new URLSearchParams(location.search).get('tinjau') === '1';
            location.href = keepTinjau ? `${location.pathname}?tinjau=1` : location.href;
          }
        } catch {
          // Keep polling while the connection recovers.
        }
      }, 4000);
    </script>
  )}
</Shell>
