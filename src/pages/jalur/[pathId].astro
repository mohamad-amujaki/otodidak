---
import { env } from 'cloudflare:workers';
import ChapterNav from '../../components/ChapterNav.astro';
import CreditNotice from '../../components/credit/CreditNotice.astro';
import GenerationWait from '../../components/GenerationWait.astro';
import Shell from '../../components/Shell.astro';
import {
  creditShortNote,
  creditTopUpFor,
  hasEnoughCredits,
} from '../../domain/credit-ui';
import { AppError } from '../../domain/errors';
import { alphaLabel } from '../../domain/format';
import { isRecord, record } from '../../domain/guard';
import type { Outline, OutlineAction } from '../../domain/outline';
import { applyOutlineAction } from '../../domain/outline';
import { startQuiz, suggestChapterLesson } from '../../server/generation';
import { saveOutline } from '../../server/outline-save';
import { activateUserPath } from '../../server/path-actions';
import { pathDetail } from '../../server/read';
import { pageMe } from '../../server/ssr';

const { pathId } = Astro.params;
if (!pathId) return Astro.redirect('/pustaka');
const page = await pageMe(Astro.request, env);
if ('redirect' in page) return Astro.redirect(page.redirect);
const { session, me: meRaw } = page;
const me = record(meRaw);
const user = record(me.user);
const config = record(me.config);
const balance = typeof me.balance === 'number' ? me.balance : 0;
const lessonCost =
  typeof config.costLesson === 'number' ? config.costLesson : 3;
const quizCost = typeof config.costQuiz === 'number' ? config.costQuiz : 1;
const lessonAffordable = hasEnoughCredits(balance, lessonCost);
const quizAffordable = hasEnoughCredits(balance, quizCost);
const resumeAction = String(Astro.url.searchParams.get('lanjut') ?? '');
const topUpFor = (action: string) => {
  const target = new URL(Astro.url);
  target.searchParams.set('lanjut', action);
  return creditTopUpFor(`${target.pathname}${target.search}`);
};
const quizTopUpHref = topUpFor('kuis');
const lessonTopUpHref = topUpFor('pelajaran');
const resumeDismissUrl = new URL(Astro.url);
resumeDismissUrl.searchParams.delete('lanjut');
const resumeDismissHref = `${resumeDismissUrl.pathname}${resumeDismissUrl.search}`;
const lowCredit = !lessonAffordable || !quizAffordable;
const resumeReady = resumeAction !== '' && (quizAffordable || lessonAffordable);
let creditShortfall: {
  balance: number;
  cost: number;
  action: 'kuis' | 'pelajaran';
} | null = null;
let message = '';
let messageIsInfo = false;
let reopenReview = Astro.url.searchParams.get('tinjau') === '1';
const detailRaw = await pathDetail(session.db, session.user.id, pathId);
if (!detailRaw) return Astro.redirect('/pustaka');
let detail = record(detailRaw);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  reopenReview = String(form.get('tinjau') ?? '') === '1';
  if (String(form.get('csrf') ?? '') !== Astro.locals.csrf) {
    message = 'Muat ulang halaman, lalu kirim lagi.';
  } else {
    const action = String(form.get('aksi') ?? '');
    if (action === 'tambah-ai') {
      const chapterId = String(form.get('chapterId') ?? '');
      try {
        await suggestChapterLesson(env, Astro.request, session.user, chapterId);
        messageIsInfo = true;
        message = 'Pelajaran baru ditambahkan dari saran AI.';
        const again = await pathDetail(session.db, session.user.id, pathId);
        if (again) detail = record(again);
      } catch (error) {
        if (error instanceof AppError && error.code === 'insufficient_credits')
          creditShortfall = { balance, cost: lessonCost, action: 'pelajaran' };
        else
          message =
            error instanceof AppError
              ? error.message
              : 'Gagal menambahkan pelajaran.';
      }
    } else if (action === 'kuis') {
      try {
        await startQuiz(
          env,
          Astro.request,
          session.user,
          String(form.get('chapterId') ?? ''),
        );
        message = 'Menyusun kuis. Muat ulang halaman ini beberapa saat lagi.';
        messageIsInfo = true;
      } catch (error) {
        if (error instanceof AppError && error.code === 'insufficient_credits')
          creditShortfall = { balance, cost: quizCost, action: 'kuis' };
        else
          message =
            error instanceof AppError ? error.message : 'Gagal memulai kuis.';
      }
    } else if (action === 'aktif') {
      try {
        await activateUserPath(session.db, session.user.id, pathId);
      } catch (error) {
        message =
          error instanceof AppError
            ? error.message
            : 'Gagal mengaktifkan jalur.';
      }
    } else {
      const outline = toOutline(detail);
      const next = applyOutlineAction(outline, actionFrom(form), {
        maxChapters:
          typeof config.maxChapters === 'number' ? config.maxChapters : 8,
        maxLessonsPerChapter:
          typeof config.maxLessonsPerChapter === 'number'
            ? config.maxLessonsPerChapter
            : 4,
      });
      if (!next.ok) message = next.message;
      else if (
        String(form.get('konfirmasi') ?? '') !== 'ya' &&
        (action === 'hapus-bab' || action === 'hapus-pelajaran')
      ) {
        message = 'Centang konfirmasi untuk menghapus.';
      } else {
        try {
          await saveOutline(session.db, session.user.id, pathId, next.outline);
          const again = await pathDetail(session.db, session.user.id, pathId);
          if (again) detail = record(again);
        } catch (error) {
          message =
            error instanceof AppError
              ? error.message
              : 'Gagal menyimpan kerangka.';
        }
      }
    }
  }
}
const chapters = Array.isArray(detail.chapters)
  ? detail.chapters.filter(isRecord)
  : [];
const navChapters = chapters.map((chapter) => ({
  id: String(chapter.id),
  title: String(chapter.title ?? 'Bab'),
  lessons: (Array.isArray(chapter.lessons)
    ? chapter.lessons.filter(isRecord)
    : []
  ).map((lesson) => ({
    id: String(lesson.id),
    title: String(lesson.title ?? 'Pelajaran'),
    completedAt:
      typeof lesson.completedAt === 'string' ? lesson.completedAt : null,
  })),
}));
const minutes =
  typeof config.lessonMinuteLabel === 'number' ? config.lessonMinuteLabel : 15;
const maxLessonsPerChapter =
  typeof config.maxLessonsPerChapter === 'number'
    ? config.maxLessonsPerChapter
    : 4;
const activeJob = isRecord(me.activeJob) ? me.activeJob : null;

type LessonView = {
  id: string;
  title: string;
  objective: string;
  completed: boolean;
  hasBody: boolean;
  status: string;
};
type ChapterView = {
  id: string;
  title: string;
  summary: string;
  quiz: unknown;
  quizStatusLabel: string;
  lessons: LessonView[];
};

const chapterViews: ChapterView[] = chapters.map((chapter) => ({
  id: String(chapter.id),
  title: String(chapter.title ?? 'Bab'),
  summary: String(chapter.summary ?? ''),
  quiz: chapter.quiz,
  quizStatusLabel: String(chapter.quizStatusLabel ?? ''),
  lessons: (Array.isArray(chapter.lessons)
    ? chapter.lessons.filter(isRecord)
    : []
  ).map((lesson) => ({
    id: String(lesson.id),
    title: String(lesson.title ?? 'Pelajaran'),
    objective: String(lesson.objective ?? ''),
    completed: lesson.completedAt !== null && lesson.completedAt !== undefined,
    hasBody: lesson.hasBody === true,
    status: String(lesson.status ?? ''),
  })),
}));

const allLessons = chapterViews.flatMap((chapter) => chapter.lessons);
const lessonCount = allLessons.length;
const progress = isRecord(detail.progress) ? detail.progress : {};
const doneFromProgress = Number(progress.done ?? 0);
const done = Number.isFinite(doneFromProgress)
  ? doneFromProgress
  : allLessons.filter((lesson) => lesson.completed).length;
const total = Number(progress.total ?? lessonCount) || lessonCount;
const percent = total > 0 ? Math.min(100, Math.round((done / total) * 100)) : 0;
const totalMinutes = lessonCount * minutes;
const isReady = detail.status === 'ready';
const isActive = detail.isActive === true;
const isComplete = isReady && lessonCount > 0 && done >= total;
const firstLesson = allLessons[0] ?? null;
const nextLesson = allLessons.find((lesson) => !lesson.completed) ?? null;
const outcomes = [
  ...new Set(
    allLessons
      .map((lesson) => lesson.objective.trim())
      .filter((objective) => objective.length > 12),
  ),
].slice(0, 5);

const statusBadge = !isReady
  ? { label: 'Menyusun', class: 'bg-hangat-lembut text-hangat' }
  : isComplete
    ? { label: 'Selesai', class: 'bg-jalur text-white' }
    : isActive
      ? { label: 'Jalur aktif', class: 'bg-jalur-lembut text-jalur' }
      : {
          label: 'Siap dipelajari',
          class: 'border border-garis bg-kartu text-tinta-lembut',
        };

function toOutline(path: Record<string, unknown>): Outline {
  const rows = Array.isArray(path.chapters)
    ? path.chapters.filter(isRecord)
    : [];
  return {
    title: String(path.title ?? ''),
    chapters: rows.map((chapter) => ({
      id: String(chapter.id),
      title: String(chapter.title ?? ''),
      summary: String(chapter.summary ?? ''),
      lessons: (Array.isArray(chapter.lessons)
        ? chapter.lessons.filter(isRecord)
        : []
      ).map((lesson) => ({
        id: String(lesson.id),
        title: String(lesson.title ?? ''),
        objective: String(lesson.objective ?? ''),
      })),
    })),
  };
}

function actionFrom(form: FormData): OutlineAction {
  const aksi = String(form.get('aksi') ?? '');
  const direction = String(form.get('arah') ?? '') === 'turun' ? 'down' : 'up';
  switch (aksi) {
    case 'judul':
      return { type: 'title', title: String(form.get('title') ?? '') };
    case 'bab':
      return {
        type: 'chapter-title',
        chapterId: String(form.get('chapterId') ?? ''),
        title: String(form.get('title') ?? ''),
      };
    case 'ringkas':
      return {
        type: 'chapter-summary',
        chapterId: String(form.get('chapterId') ?? ''),
        summary: String(form.get('summary') ?? ''),
      };
    case 'pelajaran':
      return {
        type: 'lesson',
        lessonId: String(form.get('lessonId') ?? ''),
        title: String(form.get('title') ?? ''),
        objective: String(form.get('objective') ?? ''),
      };
    case 'geser-bab':
      return {
        type: 'move-chapter',
        chapterId: String(form.get('chapterId') ?? ''),
        direction,
      };
    case 'geser-pelajaran':
      return {
        type: 'move-lesson',
        lessonId: String(form.get('lessonId') ?? ''),
        direction,
      };
    case 'tambah':
      return {
        type: 'add-lesson',
        chapterId: String(form.get('chapterId') ?? ''),
      };
    case 'hapus-pelajaran':
      return {
        type: 'delete-lesson',
        lessonId: String(form.get('lessonId') ?? ''),
      };
    case 'hapus-bab':
      return {
        type: 'delete-chapter',
        chapterId: String(form.get('chapterId') ?? ''),
      };
    default:
      return { type: 'title', title: String(form.get('title') ?? '') };
  }
}
---

<Shell title={String(detail.title ?? 'Jalur')} balance={typeof me.balance === 'number' ? me.balance : 0} lowCredit={lowCredit} role={user.role === 'admin' ? 'admin' : 'learner'} suspended={user.status === 'suspended'} userName={String(user.name)} userEmail={String(user.email)}>
  <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-1.5 text-sm text-tinta-lembut">
    <a class="inline-flex min-h-8 items-center transition-colors hover:text-jalur" href="/pustaka">Pustaka</a>
    <svg class="size-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
    <span class="max-w-[18rem] truncate" aria-current="page">{detail.title}</span>
  </nav>

  <header class="mt-4 flex flex-col gap-6 min-[900px]:flex-row min-[900px]:items-end min-[900px]:justify-between">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <p class="eyebrow">Jalur belajar</p>
        <span class:list={["inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[11px] font-semibold", statusBadge.class]}>
          <span class:list={["size-1.5 rounded-full", isActive || isComplete ? 'bg-current' : 'bg-tinta-lembut']}></span>
          {statusBadge.label}
        </span>
      </div>
      <h1 class="judul mt-2">{detail.title}</h1>
      <p class="mt-2 max-w-[62ch] text-sm leading-[1.6] text-tinta-lembut">{detail.topic}</p>

      {isReady && (
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-kontrol border border-garis bg-kartu px-2.5 py-1 text-xs font-medium text-tinta-lembut">
            <svg class="size-3.5 text-jalur" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            {chapterViews.length} bab
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-kontrol border border-garis bg-kartu px-2.5 py-1 text-xs font-medium text-tinta-lembut">
            <svg class="size-3.5 text-jalur" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h10" />
            </svg>
            {lessonCount} pelajaran
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-kontrol border border-garis bg-kartu px-2.5 py-1 text-xs font-medium text-tinta-lembut">
            <svg class="size-3.5 text-jalur" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            ±{totalMinutes} mnt
          </span>
          {total > 0 && (
            <span class="inline-flex items-center gap-1.5 rounded-kontrol border border-jalur/30 bg-jalur-lembut px-2.5 py-1 text-xs font-semibold text-jalur">
              {percent}% selesai
            </span>
          )}
        </div>
      )}

      {isReady && total > 0 && (
        <div class="mt-4 max-w-sm">
          <div class="flex items-center justify-between text-xs text-tinta-lembut">
            <span>{done} dari {total} pelajaran selesai</span>
            <span class="font-semibold tabular-nums text-tinta">{percent}%</span>
          </div>
          <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-garis">
            <div class="h-full rounded-full bg-jalur transition-all" style={`width: ${percent}%`}></div>
          </div>
        </div>
      )}
    </div>

    <div class="flex flex-wrap gap-2 min-[900px]:shrink-0">
      {isReady && isActive && nextLesson && (
        <a class="inline-flex min-h-11 w-full min-w-0 items-center justify-center gap-2 rounded-kontrol bg-jalur px-5 text-sm font-semibold text-white shadow-md transition-all hover:brightness-110 hover:shadow-lg min-[900px]:w-auto" href={`/jalur/${pathId}/pelajaran/${nextLesson.id}`}>
          <svg class="size-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
          <span class="min-[900px]:hidden">Lanjutkan belajar</span>
          <span class="hidden max-w-[24rem] truncate min-[900px]:inline">Lanjutkan: {nextLesson.title}</span>
        </a>
      )}
      {isReady && isActive && isComplete && firstLesson && (
        <a class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-kontrol bg-jalur px-5 text-sm font-semibold text-white shadow-md transition-all hover:brightness-110 hover:shadow-lg min-[900px]:w-auto" href={`/jalur/${pathId}/pelajaran/${firstLesson.id}`}>
          <svg class="size-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
          Ulangi dari awal
        </a>
      )}
      {isReady && !isActive && (
        <form class="w-full min-[900px]:w-auto" method="post">
          <input type="hidden" name="csrf" value={Astro.locals.csrf} />
          <input type="hidden" name="aksi" value="aktif" />
          <button class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-kontrol bg-jalur px-5 text-sm font-semibold text-white shadow-md transition-all hover:brightness-110 hover:shadow-lg min-[900px]:w-auto" type="submit">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            Jadikan jalur aktif
          </button>
        </form>
      )}
      {isReady && (
        <button class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-kontrol border border-garis bg-kartu px-4 text-sm font-medium text-tinta transition-colors hover:bg-kertas min-[900px]:w-auto" type="button" data-open-tinjau>
          <svg class="size-4 text-tinta-lembut" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Tinjau & sunting
        </button>
      )}
    </div>
  </header>

  {creditShortfall && (
    <div class="mt-5">
      <CreditNotice
        balance={creditShortfall.balance}
        cost={creditShortfall.cost}
        topUpHref={creditShortfall.action === 'kuis' ? quizTopUpHref : lessonTopUpHref}
      />
    </div>
  )}

  {resumeReady && !creditShortfall && (
    <div class="mt-5 rounded-kontrol border border-jalur/30 bg-jalur-lembut p-4">
      <p class="text-sm font-semibold text-jalur">
        Kredit kamu sekarang {balance}.
      </p>
      <p class="mt-1 text-sm text-tinta-lembut">
        Pilih bab yang ingin kamu susun, lalu klik tombolnya lagi.
      </p>
      <a class="mt-3 inline-flex min-h-9 items-center rounded-kontrol border border-garis bg-kartu px-3 text-sm font-medium text-tinta" href={resumeDismissHref}>
        Tutup
      </a>
    </div>
  )}

  {message && (
    <div class:list={["mt-5 rounded-kontrol border p-4", messageIsInfo ? 'border-jalur/30 bg-jalur-lembut' : 'border-bahaya/30 bg-bahaya/10']}>
      <div class="flex gap-3">
        <svg class:list={["size-5 shrink-0", messageIsInfo ? 'text-jalur' : 'text-bahaya']} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={messageIsInfo ? 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' : 'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'} />
        </svg>
        <p class:list={["text-sm", messageIsInfo ? 'text-jalur' : 'text-bahaya']}>{message}</p>
      </div>
    </div>
  )}

  {!isReady ? (
    <div class="mt-8">
      <GenerationWait
        title="Menyusun jalur belajarmu"
        description="Kami sedang memecah topik ini menjadi bab dan pelajaran yang runut. Halaman ini akan diperbarui otomatis."
        lines={3}
        jobId={activeJob ? String(activeJob.id) : undefined}
      />
    </div>
  ) : (
    <div class:list={["mt-8", chapterViews.length > 0 && "min-[1100px]:grid min-[1100px]:grid-cols-[260px_minmax(0,1fr)] min-[1100px]:items-start min-[1100px]:gap-8"]}>
      {chapterViews.length > 0 && (
        <ChapterNav
          pathId={pathId}
          chapters={navChapters}
          onPath={true}
          currentLessonId={nextLesson?.id}
          progress={{ done: doneFromProgress, total }}
        />
      )}
      <div class:list={["min-w-0 space-y-6", chapterViews.length > 0 && "mt-6 min-[1100px]:mt-0"]}>
        {outcomes.length > 0 && (
          <section class="rounded-xl border border-garis bg-kartu p-5 shadow-sm">
            <h2 class="text-[11px] font-bold uppercase tracking-[0.08em] text-tinta-lembut">Yang akan bisa kamu lakukan</h2>
            <ul class="mt-3 space-y-2.5">
              {outcomes.map((outcome) => (
                <li class="flex gap-2.5 text-sm leading-[1.55] text-tinta">
                  <svg class="mt-0.5 size-4 shrink-0 text-jalur" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{outcome}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {chapterViews.length > 0 && (
        <section>
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <h2 class="text-lg font-bold text-tinta">Urutan bab</h2>
              <p class="mt-1 text-sm text-tinta-lembut">Ikuti dari atas ke bawah, atau lompat ke bab yang kamu butuhkan.</p>
              {allLessons.some((lesson) => !lesson.hasBody) && (
                <p class="mt-1 text-xs text-tinta-lembut">Pelajaran yang masih kerangka akan disusun saat pertama kali dibuka.</p>
              )}
            </div>
            <button class="inline-flex min-h-11 items-center gap-2 rounded-kontrol border border-garis bg-kartu px-3 text-sm font-medium text-tinta transition-colors hover:bg-kertas" type="button" data-open-tinjau>
              <svg class="size-4 text-tinta-lembut" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
              </svg>
              Sunting urutan
            </button>
          </div>

          <div class="mt-4 space-y-4">
            {chapterViews.map((chapter, chapterIndex) => {
              const chapterDone = chapter.lessons.filter((lesson) => lesson.completed).length;
              const chapterTotal = chapter.lessons.length;
              const chapterPercent = chapterTotal > 0 ? Math.min(100, Math.round((chapterDone / chapterTotal) * 100)) : 0;
              return (
                <article id={`bab-${chapter.id}`} class="scroll-mt-24 overflow-hidden rounded-xl border border-garis bg-kartu shadow-sm">
                  <header class="border-b border-garis p-5">
                    <div class="flex items-start gap-3">
