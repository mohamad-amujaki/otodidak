---
import { env } from 'cloudflare:workers';
import GenerationWait from '../components/GenerationWait.astro';
import Shell from '../components/Shell.astro';
import { AppError } from '../domain/errors';
import { minuteLabel } from '../domain/format';
import { isRecord, record } from '../domain/guard';
import { topicSchema } from '../domain/schemas';
import { startRoadmap } from '../server/generation';
import { library } from '../server/read';
import { pageMe } from '../server/ssr';

const topicPrefill = String(Astro.url.searchParams.get('topik') ?? '').slice(
  0,
  280,
);
const page = await pageMe(Astro.request, env);
if ('redirect' in page) return Astro.redirect(page.redirect);
const { session, me } = page;
let message = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('csrf') ?? '') !== Astro.locals.csrf)
    message = 'Muat ulang halaman, lalu kirim lagi.';
  else {
    const topicRaw = String(form.get('topic') ?? '');
    const parsed = topicSchema.safeParse({ topic: topicRaw });
    if (!parsed.success) message = 'Topik tidak valid.';
    else {
      try {
        const started = await startRoadmap(
          env,
          Astro.request,
          session.user,
          parsed.data.topic,
        );
        return Astro.redirect(`/jalur/${started.pathId}?tinjau=1`);
      } catch (error) {
        message =
          error instanceof AppError ? error.message : 'Gagal memulai jalur.';
      }
    }
  }
}
const user = record(me.user);
const config = record(me.config);
const activePath = isRecord(me.activePath) ? me.activePath : null;
const nextLesson =
  activePath && isRecord(activePath.nextLesson) ? activePath.nextLesson : null;
const activeJob = isRecord(me.activeJob) ? me.activeJob : null;
const streak = isRecord(me.streak) ? me.streak : null;
const lines = Array.isArray(streak?.lines)
  ? streak.lines.filter((line) => typeof line === 'string')
  : [];
const minutes =
  typeof config.lessonMinuteLabel === 'number' ? config.lessonMinuteLabel : 15;
const cost = typeof config.costRoadmap === 'number' ? config.costRoadmap : 6;
const showForm = !activePath || Astro.url.searchParams.has('baru');

const paths = (await library(session.db, session.user.id)).filter(isRecord);

// Calculate stats
const totalPaths = paths.length;
const activePaths = paths.filter((p) => p.isActive === true).length;
let completedLessons = 0;
let totalLessons = 0;
paths.forEach((path) => {
  const progress = isRecord(path.progress) ? path.progress : {};
  completedLessons += Number(progress.done ?? 0);
  totalLessons += Number(progress.total ?? 0);
});

const activePathId = activePath ? String(activePath.id) : '';
const activePathRow = activePathId
  ? paths.find((p) => String(p.id) === activePathId)
  : null;
const activePathProgress =
  activePathRow && isRecord(activePathRow.progress)
    ? activePathRow.progress
    : null;
const activePathDone = activePathProgress
  ? Number(activePathProgress.done ?? 0)
  : 0;
const activePathTotal = activePathProgress
  ? Number(activePathProgress.total ?? 0)
  : 0;
const activePathPercentage =
  activePathTotal > 0
    ? Math.round((activePathDone / activePathTotal) * 100)
    : 0;
const streakCount =
  streak && typeof streak.count === 'number' ? streak.count : 0;
const balance = typeof me.balance === 'number' ? me.balance : 0;
const lowCredit = balance < cost;
---
<Shell title="Dasbor" sectionLabel="Dasbor" balance={balance} role={user.role === 'admin' ? 'admin' : 'learner'} suspended={user.status === 'suspended'} userName={String(user.name)} userEmail={String(user.email)}>
  <div class="mb-6">
    <h1 class="judul">Dasbor</h1>
    <p class="mt-2 text-tinta-lembut">Selamat datang kembali, {user.name}</p>
    {streak && streakCount > 0 && (
      <p class="mt-2 text-sm text-tinta-lembut">
        <span class="font-semibold tabular-nums text-hangat">{streakCount} hari</span>
        {' '}
        runtun belajar
        {lines.length > 1 && (
          <span class="text-tinta-lembut"> · {lines.slice(1).join(' ')}</span>
        )}
      </p>
    )}
  </div>

  {message && (
    <div class="mb-6 rounded-kontrol border border-bahaya/30 bg-bahaya/10 p-4">
      <div class="flex gap-3">
        <svg class="size-5 shrink-0 text-bahaya" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-sm text-bahaya">{message}</p>
      </div>
    </div>
  )}

  {activeJob && (
    <div class="mb-6">
      <GenerationWait
        title="Menyusun jalur"
        description="Tunggu sebentar, kami sedang membuat roadmap belajarmu."
        lines={3}
        compact
        jobId={String(activeJob.id)}
      />
    </div>
  )}

  {activePath && nextLesson && (
    <article class="mb-8 rounded-kartu border border-garis border-l-4 border-l-jalur bg-kartu p-5 shadow-sm md:p-6">
      <p class="text-[11px] font-semibold uppercase tracking-[0.08em] text-tinta-lembut">
        Lanjutkan belajar
      </p>
      <h2 class="mt-2 text-xl font-bold text-tinta">{String(nextLesson.title)}</h2>
      <p class="mt-1 text-sm text-tinta-lembut">{String(activePath.title)}</p>
      <p class="mt-3 text-sm tabular-nums text-tinta-lembut">
        {minuteLabel(minutes)}
        {activePathTotal > 0 && ` · ${activePathDone} dari ${activePathTotal} pelajaran`}
      </p>
      {activePathTotal > 0 && (
        <div class="mt-3 h-2 overflow-hidden rounded-full bg-kertas" role="progressbar" aria-valuenow={activePathPercentage} aria-valuemin="0" aria-valuemax="100" aria-label={`Progres ${String(activePath.title)}`}>
          <div
            class="h-full bg-jalur transition-[width] duration-300"
            style={`width: ${activePathPercentage}%`}
          />
        </div>
      )}
      <a
        class="mt-5 inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-kontrol bg-jalur px-5 font-semibold text-white transition-[filter] hover:brightness-110 sm:w-auto"
        href={`/jalur/${String(activePath.id)}/pelajaran/${String(nextLesson.id)}`}
      >
        Lanjut
        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </article>
  )}

  {!activePath && !activeJob && (
    <div class="mb-6 rounded-kartu border border-garis bg-kartu p-8 text-center shadow-sm">
      <div class="mx-auto flex size-16 items-center justify-center rounded-kontrol bg-jalur-lembut text-jalur">
        <svg class="size-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <h2 class="mt-4 text-xl font-bold text-tinta">Belum ada jalur belajar</h2>
      <p class="mt-2 text-tinta-lembut">Tulis satu hal yang ingin kamu kuasai dan mulai perjalanan belajarmu.</p>
    </div>
  )}

  {totalPaths > 0 && (
    <div class="mb-8 grid grid-cols-3 gap-2 rounded-kartu border border-garis bg-kartu p-3 shadow-sm md:gap-4 md:rounded-none md:border-0 md:bg-transparent md:p-0 md:shadow-none">
      <div class="flex min-w-0 flex-col gap-0.5 [&>div:first-child]:hidden md:flex-row md:items-center md:gap-4 md:rounded-kartu md:border md:border-garis md:bg-kartu md:p-5 md:shadow-sm md:[&>div:first-child]:flex">
        <div class="flex size-12 shrink-0 items-center justify-center rounded-kontrol bg-jalur-lembut text-jalur">
          <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
        </div>
        <div>
          <p class="text-lg font-bold tabular-nums text-tinta md:text-2xl">{totalPaths}</p>
          <p class="text-xs leading-tight text-tinta-lembut md:text-sm">Jalur di pustaka</p>
        </div>
      </div>
      <div class="flex min-w-0 flex-col gap-0.5 [&>div:first-child]:hidden md:flex-row md:items-center md:gap-4 md:rounded-kartu md:border md:border-garis md:bg-kartu md:p-5 md:shadow-sm md:[&>div:first-child]:flex">
        <div class="flex size-12 shrink-0 items-center justify-center rounded-kontrol bg-jalur text-white">
          <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <p class="text-lg font-bold tabular-nums text-tinta md:text-2xl">{completedLessons}/{totalLessons}</p>
          <p class="text-xs leading-tight text-tinta-lembut md:text-sm">Pelajaran selesai</p>
        </div>
      </div>
      <div class="flex min-w-0 flex-col gap-0.5 [&>div:first-child]:hidden md:flex-row md:items-center md:gap-4 md:rounded-kartu md:border md:border-jalur/20 md:bg-jalur-lembut/30 md:p-5 md:shadow-sm md:[&>div:first-child]:flex">
        <div class="flex size-12 shrink-0 items-center justify-center rounded-kontrol bg-jalur text-white">
          <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div>
          <p class="text-lg font-bold tabular-nums text-jalur md:text-2xl">{activePaths}</p>
          <p class="text-xs leading-tight text-tinta-lembut md:text-sm">Jalur aktif</p>
        </div>
      </div>
    </div>
  )}

  <!-- Quick Actions -->
  <div class="mb-6 grid gap-4 md:grid-cols-3">
    <a
      class:list={[
        'flex items-center gap-4 rounded-kartu border p-4 transition-colors',
        lowCredit
          ? 'border-hangat/40 bg-hangat-lembut/30 hover:border-hangat/60'
          : 'border-garis bg-kartu hover:border-jalur/40',
      ]}
      href="/kredit"
    >
      <div class="flex size-12 shrink-0 items-center justify-center rounded-kontrol bg-jalur-lembut text-jalur">
        <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
        </svg>
      </div>
      <div class="min-w-0 flex-1">
        <p class="font-semibold text-tinta">Isi Kredit</p>
        <p class="text-sm text-tinta-lembut">
          {lowCredit
            ? `Saldo ${balance} — belum cukup untuk jalur baru (${cost} kredit)`
            : 'Beli lebih banyak kredit'}
        </p>
      </div>
      <svg class="size-5 shrink-0 text-tinta-lembut" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>

    <a 
      class="flex items-center gap-4 rounded-kartu border border-garis bg-kartu p-4 transition-colors hover:border-jalur/40" 
      href="/pustaka"
    >
      <div class="flex size-12 shrink-0 items-center justify-center rounded-kontrol bg-jalur-lembut text-jalur">
        <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
        </svg>
      </div>
      <div class="min-w-0 flex-1">
        <p class="font-semibold text-tinta">Pustaka</p>
        <p class="text-sm text-tinta-lembut">Lihat semua jalur belajar</p>
      </div>
      <svg class="size-5 shrink-0 text-tinta-lembut" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>

    {activePath && !showForm && (
      <a
        class="flex items-center gap-4 rounded-kartu border border-garis bg-kartu p-4 transition-colors hover:border-jalur/40"
        href="/dasbor?baru=1"
      >
        <div class="flex size-12 shrink-0 items-center justify-center rounded-kontrol bg-jalur-lembut text-jalur">
          <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <p class="font-semibold text-tinta">Buat Jalur Baru</p>
          <p class="text-sm text-tinta-lembut">Mulai topik lain dari nol</p>
        </div>
        <svg class="size-5 shrink-0 text-tinta-lembut" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    )}
  </div>

  <!-- New Path Form -->
  {showForm && (
    <div class="rounded-kartu border border-garis bg-kartu p-6 md:p-8">
      <div class="mb-4 flex items-start gap-3">
        <div class="flex size-10 shrink-0 items-center justify-center rounded-kontrol bg-jalur-lembut text-jalur">
          <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
        </div>
        <div>
          <h2 class="text-lg font-bold text-tinta">Buat Jalur Baru</h2>
          <p class="mt-1 text-sm text-tinta-lembut">Ceritakan topik yang ingin kamu pelajari</p>
        </div>
      </div>
      <form class="mt-6" method="post">
        <input type="hidden" name="csrf" value={Astro.locals.csrf} />
        <label class="block text-sm font-medium text-tinta" for="topic">Apa yang ingin kamu pelajari?</label>
        <p class="mt-1 text-sm text-tinta-lembut" id="topic-help">Satu kalimat cukup. Contoh: "Cara menanam kopi di rumah"</p>
        <textarea 
          class="mt-3 min-h-28 rounded-kontrol border border-garis bg-kartu py-3 px-4 text-base transition-colors focus:border-jalur focus:ring-2 focus:ring-jalur/20" 
          id="topic" 
          name="topic" 
          maxlength="280" 
          required 
          aria-describedby="topic-help"
          placeholder="Tulis topik yang ingin kamu pelajari..."
        >{topicPrefill}</textarea>
        <div class="mt-4 flex flex-col items-start gap-3 md:flex-row md:items-center md:justify-between">
          <div class="flex items-center gap-2 text-sm text-tinta-lembut">
            <svg class="size-5 text-jalur" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Memakai <strong class="font-semibold text-tinta">{cost} kredit</strong></span>
          </div>
          <button 
            class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-kontrol bg-jalur px-6 font-semibold text-white transition-[filter] hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60 md:w-auto" 
            type="submit" 
            disabled={Boolean(activeJob)}
          >
            {activeJob ? (
              <>
                <svg class="size-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span>Menyusun...</span>
              </>
            ) : (
              <>
                <span>Susun Jalur</span>
                <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </>
            )}
          </button>
        </div>
      </form>
    </div>
  )}


</Shell>
