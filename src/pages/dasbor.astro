---
import { env } from 'cloudflare:workers';
import GenerationWait from '../components/GenerationWait.astro';
import Shell from '../components/Shell.astro';
import { AppError } from '../domain/errors';
import { minuteLabel } from '../domain/format';
import { generationFailureMessage } from '../domain/generation-failure';
import { isRecord, record } from '../domain/guard';
import { topicSchema } from '../domain/schemas';
import { startRoadmap } from '../server/generation';
import { library } from '../server/read';
import { pageMe } from '../server/ssr';

const topicPrefill = String(Astro.url.searchParams.get('topik') ?? '').slice(
  0,
  280,
);
const page = await pageMe(Astro.request, env);
if ('redirect' in page) return Astro.redirect(page.redirect);
const { session, me } = page;
let message = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('csrf') ?? '') !== Astro.locals.csrf)
    message = 'Muat ulang halaman, lalu kirim lagi.';
  else {
    const topicRaw = String(form.get('topic') ?? '');
    const parsed = topicSchema.safeParse({ topic: topicRaw });
    if (!parsed.success) message = 'Topik tidak valid.';
    else {
      try {
        const started = await startRoadmap(
          env,
          Astro.request,
          session.user,
          parsed.data.topic,
        );
        return Astro.redirect(`/jalur/${started.pathId}?tinjau=1`);
      } catch (error) {
        message =
          error instanceof AppError ? error.message : 'Gagal memulai jalur.';
      }
    }
  }
}
const user = record(me.user);
const config = record(me.config);
const activePath = isRecord(me.activePath) ? me.activePath : null;
const nextLesson =
  activePath && isRecord(activePath.nextLesson) ? activePath.nextLesson : null;
const activeJob = isRecord(me.activeJob) ? me.activeJob : null;
const failedJob = isRecord(me.failedJob) ? me.failedJob : null;
const streak = isRecord(me.streak) ? me.streak : null;
const lines = Array.isArray(streak?.lines)
  ? streak.lines.filter((line) => typeof line === 'string')
  : [];
const minutes =
  typeof config.lessonMinuteLabel === 'number' ? config.lessonMinuteLabel : 15;
const cost = typeof config.costRoadmap === 'number' ? config.costRoadmap : 6;
const showForm = !activePath || Astro.url.searchParams.has('baru');

const paths = (await library(session.db, session.user.id)).filter(isRecord);

// Calculate stats
const totalPaths = paths.length;
const activePaths = paths.filter((p) => p.isActive === true).length;
let completedLessons = 0;
let totalLessons = 0;
paths.forEach((path) => {
  const progress = isRecord(path.progress) ? path.progress : {};
  completedLessons += Number(progress.done ?? 0);
  totalLessons += Number(progress.total ?? 0);
});

const activePathId = activePath ? String(activePath.id) : '';
const activePathRow = activePathId
  ? paths.find((p) => String(p.id) === activePathId)
  : null;
const activePathProgress =
  activePathRow && isRecord(activePathRow.progress)
    ? activePathRow.progress
    : null;
const activePathDone = activePathProgress
  ? Number(activePathProgress.done ?? 0)
  : 0;
const activePathTotal = activePathProgress
  ? Number(activePathProgress.total ?? 0)
  : 0;
const activePathPercentage =
  activePathTotal > 0
    ? Math.round((activePathDone / activePathTotal) * 100)
    : 0;
const streakCount =
  streak && typeof streak.count === 'number' ? streak.count : 0;
const balance = typeof me.balance === 'number' ? me.balance : 0;
const lowCredit = balance < cost;
const rawName = String(user.name ?? '').trim();
const firstName = rawName.split(/\s+/)[0] || '';
const chapterTitle =
  nextLesson && typeof nextLesson.chapterTitle === 'string'
    ? nextLesson.chapterTitle
    : '';
const pathFinished = Boolean(activePath && !nextLesson && !activeJob);
const hasLibrary = totalPaths > 0;
---
<Shell title="Dasbor" sectionLabel="Dasbor" balance={balance} role={user.role === 'admin' ? 'admin' : 'learner'} suspended={user.status === 'suspended'} userName={String(user.name)} userEmail={String(user.email)}>
  <div class="mb-6 sm:mb-8">
    <h1 class="judul break-words">{firstName ? firstName : 'Dasbor'}</h1>
    {streak && streakCount > 0 ? (
      <p class="mt-2 max-w-xl text-pretty text-sm text-tinta-lembut sm:text-base">
        <span class="font-semibold tabular-nums text-hangat">{streakCount} hari</span>
        {' '}runtun belajar
        {lines.length > 1 && <span class="mt-1 block">{lines.slice(1).join(' ')}</span>}
      </p>
    ) : (
      <p class="mt-2 max-w-xl text-pretty text-sm text-tinta-lembut sm:text-base">
        {nextLesson
          ? 'Pelajaran berikutnya sudah menunggu.'
          : pathFinished
            ? 'Jalur aktifmu sudah selesai.'
            : 'Satu topik cukup untuk mulai.'}
      </p>
    )}
  </div>

  {message && (
    <div class="mb-6 rounded-kontrol border border-bahaya/30 bg-bahaya/10 p-4">
      <div class="flex gap-3">
        <svg class="size-5 shrink-0 text-bahaya" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-sm text-bahaya">{message}</p>
      </div>
    </div>
  )}

  {failedJob && !activeJob && (
    <div class="mb-6 rounded-kontrol border border-bahaya/30 bg-bahaya/10 p-4">
      <div class="flex gap-3">
        <svg class="size-5 shrink-0 text-bahaya" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <div class="min-w-0">
          <p class="text-sm font-semibold text-bahaya">
            Pembuatan terakhir gagal
          </p>
          <p class="mt-1 text-sm text-tinta">
            {generationFailureMessage(String(failedJob.errorCode ?? ''))}
          </p>
          {failedJob.errorDetail && (
            <p class="mt-1 break-words text-xs text-tinta-lembut">
              {String(failedJob.errorDetail)}
            </p>
          )}
          <a
            class="mt-2 inline-flex min-h-11 items-center text-sm font-semibold text-jalur hover:underline"
            href={failedJob.kind === 'roadmap' ? '/dasbor?baru' : '/pustaka'}
          >
            Coba lagi
          </a>
        </div>
      </div>
    </div>
  )}

  {activeJob && (
    <div class="mb-6">
      <GenerationWait
        title="Menyusun jalur"
        description="Tunggu sebentar, kami sedang membuat roadmap belajarmu."
        lines={3}
        compact
        jobId={String(activeJob.id)}
      />
    </div>
  )}

  <div
    class:list={[
      'lg:grid lg:items-start lg:gap-10',
      hasLibrary
        ? 'lg:grid-cols-[minmax(0,1fr)_16.5rem]'
        : 'mx-auto max-w-xl',
    ]}
  >
    <div class="min-w-0 space-y-6 lg:col-start-1">
      {activePath && nextLesson && (
        <article class="rounded-kartu border border-garis border-l-4 border-l-jalur bg-kartu p-4 shadow-sm sm:p-6">
          <p class="eyebrow">Lanjutkan</p>
          <h2 class="mt-2 break-words text-pretty text-xl font-bold text-tinta sm:text-2xl">{String(nextLesson.title)}</h2>
          <p class="mt-1 text-pretty text-sm text-tinta-lembut">
            {chapterTitle && <span>{chapterTitle}</span>}
            {chapterTitle && ' · '}
            {String(activePath.title)}
          </p>
          {activePathTotal > 0 && (
            <div class="mt-4">
              <div class="mb-1.5 flex items-baseline justify-between gap-3 text-xs tabular-nums text-tinta-lembut">
                <span>{activePathDone} dari {activePathTotal}</span>
                <span>{activePathPercentage}%</span>
              </div>
              <div class="h-1.5 overflow-hidden rounded-full bg-kertas" role="progressbar" aria-valuenow={activePathPercentage} aria-valuemin="0" aria-valuemax="100" aria-label={`Progres ${String(activePath.title)}`}>
                <div
                  class="h-full rounded-full bg-jalur transition-[width] duration-300"
                  style={`width: ${activePathPercentage}%`}
                />
              </div>
            </div>
          )}
          <p class="mt-3 text-sm text-tinta-lembut">{minuteLabel(minutes)}</p>
          <a
            class="btn-jalur mt-5 w-full px-5 sm:w-auto"
            href={`/jalur/${String(activePath.id)}/pelajaran/${String(nextLesson.id)}`}
          >
            Lanjutkan pelajaran
          </a>
        </article>
      )}

      {pathFinished && !showForm && activePath && (
        <article class="rounded-kartu border border-garis bg-kartu p-4 shadow-sm sm:p-6">
          <p class="eyebrow">Selesai</p>
          <h2 class="mt-2 text-pretty text-xl font-bold text-tinta">{String(activePath.title)}</h2>
          <p class="mt-2 text-pretty text-sm text-tinta-lembut">Semua pelajaran di jalur ini sudah selesai.</p>
          <a class="btn-jalur mt-5 w-full px-5 sm:w-auto" href="/dasbor?baru=1">Mulai topik lain</a>
        </article>
      )}

      {showForm && (
        <section class="rounded-kartu border border-garis bg-kartu p-4 shadow-sm sm:p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 class="text-lg font-bold text-tinta">
              {activePath ? 'Topik lain' : 'Jalur pertama'}
            </h2>
            {activePath && (
              <a class="inline-flex min-h-11 items-center text-sm font-medium text-tinta-lembut hover:text-jalur" href="/dasbor">Batal</a>
            )}
          </div>
          <p class="mt-1 text-pretty text-sm text-tinta-lembut">
            {pathFinished && activePath
              ? `Jalur ${String(activePath.title)} sudah selesai. Tulis topik berikutnya.`
              : 'Satu kalimat. Contoh: cara menanam kopi di rumah.'}
          </p>
          <form class="mt-5" method="post">
            <input type="hidden" name="csrf" value={Astro.locals.csrf} />
            <label class="block text-sm font-medium text-tinta" for="topic">Apa yang ingin kamu pelajari?</label>
            <textarea
              class="mt-2 min-h-28 border border-garis bg-kartu py-3 text-base transition-colors focus:border-jalur focus:ring-2 focus:ring-jalur/20"
              id="topic"
              name="topic"
              maxlength="280"
              required
              aria-describedby="topic-help"
              placeholder="Tulis topiknya"
            >{topicPrefill}</textarea>
            <p class="mt-2 text-sm text-tinta-lembut" id="topic-help">Maksimal 280 karakter. Menyusun jalur memakai {cost} kredit.</p>
            <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <p class="text-sm text-tinta-lembut">
                Saldo <span class="font-semibold tabular-nums text-tinta">{balance}</span>
              </p>
              {activeJob ? (
                <button class="btn-jalur w-full px-6 disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto" type="submit" disabled>
                  <svg class="size-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                  <span>Menyusun</span>
                </button>
              ) : lowCredit ? (
                <a class="btn-jalur w-full px-6 sm:w-auto" href="/kredit">Isi kredit dulu</a>
              ) : (
                <button class="btn-jalur w-full px-6 sm:w-auto" type="submit">Susun jalur</button>
              )}
            </div>
          </form>
        </section>
      )}
    </div>

    {hasLibrary && (
      <aside class="mt-8 min-w-0 lg:sticky lg:top-[calc(var(--header-h)+1.5rem)] lg:col-start-2 lg:row-start-1 lg:mt-0">
        <section class="rounded-kartu border border-garis bg-kartu shadow-sm" aria-label="Ringkasan belajar">
          <dl class="grid grid-cols-3 divide-x divide-garis">
            <div class="min-w-0 px-3 py-4 sm:px-4">
              <dt class="text-xs text-tinta-lembut">Jalur</dt>
              <dd class="mt-1 text-2xl font-bold tabular-nums text-tinta">{totalPaths}</dd>
            </div>
            <div class="min-w-0 px-3 py-4 sm:px-4">
              <dt class="text-xs text-tinta-lembut">Selesai</dt>
              <dd class="mt-1 text-2xl font-bold tabular-nums text-tinta">{completedLessons}</dd>
              {totalLessons > 0 && (
                <p class="text-xs tabular-nums text-tinta-lembut">dari {totalLessons}</p>
              )}
            </div>
            <div class="min-w-0 px-3 py-4 sm:px-4">
              <dt class="text-xs text-tinta-lembut">Aktif</dt>
              <dd class="mt-1 text-2xl font-bold tabular-nums text-jalur">{activePaths}</dd>
            </div>
          </dl>
        </section>

        {lowCredit && (
          <p class="mt-4 text-pretty text-sm text-hangat">
            Saldo {balance} belum cukup untuk jalur baru ({cost} kredit).
            {' '}
            <a class="font-semibold underline" href="/kredit">Isi kredit</a>
          </p>
        )}

        <nav class="mt-2" aria-label="Lainnya di dasbor">
          <a class="flex min-h-11 items-center justify-between border-b border-garis text-sm font-medium text-tinta hover:text-jalur" href="/pustaka">
            Pustaka
            <span aria-hidden="true">→</span>
          </a>
          {activePath && !showForm && !pathFinished && (
            <a class="flex min-h-11 items-center justify-between text-sm font-medium text-tinta hover:text-jalur" href="/dasbor?baru=1">
              Topik lain
              <span aria-hidden="true">→</span>
            </a>
          )}
        </nav>
      </aside>
    )}
  </div>
</Shell>
