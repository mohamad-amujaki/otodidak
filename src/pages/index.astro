---
import { env } from 'cloudflare:workers';
import AuthButton from '../components/AuthButton.astro';
import Shell from '../components/Shell.astro';
import { SEED_CONFIG } from '../domain/defaults';
import {
  clerkConfigured,
  clerkHost,
  clerkPublishableKeyFromEnv,
} from '../domain/guard';
import { pageSession } from '../server/ssr';

const existing = await pageSession(Astro.request, env);
if (existing) return Astro.redirect('/dasbor');
const publishableKey = clerkPublishableKeyFromEnv(env);
const host = clerkHost(publishableKey);
const realAuth = clerkConfigured(env) && Boolean(host);

const siteTitle = 'Otodidak — Ubah Satu Topik Jadi Jalur Belajar Otomatis';
const siteDescription = `Tulis satu topik. Otodidak menyusun roadmap-nya lebih dulu, lalu menulis pelajaran sesuai kebutuhanmu saat kamu buka — ${SEED_CONFIG.signupCredits} kredit gratis, tanpa kartu kredit.`;

const contoh = [
  {
    judul: 'Menyiapkan media',
    isi: 'Pot, tanah, dan air untuk tanaman kopi di rumah.',
  },
  {
    judul: 'Cahaya dan siram',
    isi: 'Ritme singkat yang bisa diulang tiap pagi.',
  },
  {
    judul: 'Membaca daun',
    isi: 'Tanda yang perlu dicek sebelum mengganti kebiasaan.',
  },
];

const personas = [
  {
    label: 'Arif',
    umur: 21,
    konteks: 'Butuh skill praktis untuk dunia kerja',
    topik: 'SQL & Excel untuk Analisis Data',
    detail: '6 bab · 22 pelajaran',
    alur: 'Excel → SQL → Studi Kasus',
  },
  {
    label: 'Joko',
    umur: 29,
    konteks: 'Naik level di peran sekarang',
    topik: 'Marketing Analytics & Growth',
    detail: '5 bab · 20 pelajaran',
    alur: 'Metrik → Atribusi → Eksperimen',
  },
  {
    label: 'Budi',
    umur: 26,
    konteks: 'Belum tahu harus mulai dari mana',
    topik: 'Data Analytics dari Nol',
    detail: '7 bab · 28 pelajaran',
    alur: 'Spreadsheet → SQL → Statistik → Dashboard',
  },
];

const langkah = [
  {
    judul: 'Tulis topikmu',
    isi: 'Satu kalimat cukup — soal apa yang ingin kamu kuasai.',
  },
  {
    judul: 'Roadmap disusun',
    isi: 'Urutan bab dan pelajaran dibuat lebih dulu, sebelum isinya ditulis.',
  },
  {
    judul: 'Buka pelajaran',
    isi: 'Isi ditulis saat kamu membukanya, disesuaikan dengan kebutuhanmu.',
  },
  {
    judul: 'Rujukan bila tersedia',
    isi: 'Bila ada, video pendukung ditautkan. Materi tanpa rujukan ditampilkan apa adanya.',
  },
  {
    judul: 'Cek pemahaman & progres',
    isi: 'Quiz singkat dan progres yang terlihat agar kamu benar-benar menyelesaikan jalurnya.',
  },
];

const masalah = [
  {
    judul: 'Bingung mulai dari mana',
    isi: 'Ingin belajar sesuatu, tapi tak yakin bagian mana yang penting dan urutannya.',
    jawaban:
      'Menyusun urutan bab lebih dulu — sebelum satu kata materi ditulis.',
  },
  {
    judul: 'Materi berserak',
    isi: 'Chat AI menjawab apa pun yang ditanya, tapi tanpa jalur dan langkah berikutnya.',
    jawaban:
      'Menulis pelajaran per sub-bab yang tersambung jadi satu jalur, bukan kumpulan tab.',
  },
  {
    judul: 'Lupa sudah lewat apa',
    isi: 'Mudah mengulang hal yang sama atau diam-diam melewatkan yang lain.',
    jawaban:
      'Setiap pelajaran punya posisi dan status selesai yang terlihat di pustaka.',
  },
  {
    judul: 'Progres tak terlihat',
    isi: 'Tanpa rasa bergerak, semangat memudar dan topik setengah jalan menumpuk.',
    jawaban:
      'Menghitung pelajaran selesai dan runtun harian, jadi kamu tahu sudah sampai mana.',
  },
  {
    judul: 'Jawaban susah dipercaya',
    isi: 'Kalau sumbernya tak terlihat, sulit tahu apakah kamu benar-benar paham.',
    jawaban:
      'Menandai sumber tiap klaim; bila tidak ada rujukan, materi menyatakannya.',
  },
];

const prinsip = [
  {
    judul: 'Kredit transparan, tanpa langganan',
    isi: `${SEED_CONFIG.signupCredits} kredit saat mendaftar, tanpa kartu. Beli paket lewat QRIS saat butuh — tidak ada biaya bulanan.`,
  },
  {
    judul: 'Progres yang terlihat',
    isi: 'Tiap pelajaran yang selesai tercatat. Kamu bisa melihat posisi dan ritme belajarmu tanpa menebak.',
  },
];

const faq = [
  {
    t: 'Apakah perlu kartu kredit?',
    j: `Tidak. Kamu mendapat ${SEED_CONFIG.signupCredits} kredit gratis saat mendaftar. Paket kredit dibeli lewat QRIS hanya saat kamu membutuhkannya.`,
  },
  {
    t: 'Apakah materinya punya rujukan?',
    j: 'Bila tersedia, kami menautkan video YouTube pendukung. Tidak semua topik punya rujukan video; materi lain ditulis dari pengetahuan model, jadi sebaiknya cek ulang untuk keputusan penting.',
  },
  {
    t: 'Apa bedanya dengan ChatGPT?',
    j: 'Chat AI menjawab pertanyaanmu. Otodidak menyusun jalur belajarnya — urutan bab, pelajaran, quiz, dan progres yang bisa kamu lihat.',
  },
  {
    t: 'Apakah ada langganan bulanan?',
    j: 'Tidak ada. Otodidak memakai kredit yang kamu beli sesuai kebutuhan, tanpa biaya bulanan yang mengunci akses.',
  },
  {
    t: 'Kalau kredit habis?',
    j: 'Isi ulang kapan saja lewat halaman Kredit. Progres dan jalur belajarmu tetap tersimpan.',
  },
];

const origin = Astro.site ?? new URL(Astro.url.origin);
const homeUrl = new URL('/', origin).href;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Otodidak',
      url: homeUrl,
      logo: new URL('/favicon.svg', origin).href,
    },
    {
      '@type': 'WebSite',
      name: 'Otodidak',
      url: homeUrl,
      inLanguage: 'id-ID',
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Otodidak',
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Web',
      url: homeUrl,
      description: siteDescription,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'IDR',
        description: `${SEED_CONFIG.signupCredits} kredit gratis untuk pengguna baru`,
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.t,
        acceptedAnswer: { '@type': 'Answer', text: item.j },
      })),
    },
  ],
}).replace(/</g, '\\u003c');
---
<Shell title={siteTitle} description={siteDescription} realAuth={realAuth}>
  {realAuth && (
    <>
      <meta name="clerk-key" content={publishableKey} />
      <meta name="clerk-host" content={host} />
    </>
  )}
  <script type="application/ld+json" set:html={jsonLd} />

  <!-- Hero -->
  <section class="grid items-start gap-12 lg:grid-cols-[minmax(0,1fr)_21rem]">
    <div>
      <p class="eyebrow flex items-center gap-3">
        <span class="h-px w-8 bg-jalur/40" aria-hidden="true"></span>
        Belajar mandiri, terstruktur
      </p>
      <h1 class="mt-5 max-w-3xl text-4xl font-bold leading-[1.08] tracking-tight text-tinta md:text-5xl min-[1100px]:text-6xl">
        Ubah satu topik jadi jalur belajar yang utuh
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-tinta-lembut md:text-xl">
        Tulis apa yang ingin kamu kuasai. Otodidak menyusun roadmap-nya lebih dulu, lalu menulis pelajarannya saat kamu buka.
      </p>
      <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
        <AuthButton
          class="btn-jalur w-full max-md:hidden sm:w-auto sm:px-8"
          label="Mulai gratis dengan Google"
          real={realAuth}
        />
        <a
          class="inline-flex min-h-12 w-full items-center justify-center rounded-kontrol border border-garis bg-kartu px-8 text-base font-semibold text-tinta transition-colors hover:border-jalur/40 sm:w-auto"
          href="#cara-kerja"
        >
          Lihat cara kerjanya
        </a>
      </div>
      <dl class="mt-10 flex flex-wrap items-baseline gap-x-8 gap-y-3 border-t border-garis pt-5 text-sm">
        <div class="flex items-baseline gap-2">
          <dt class="text-tinta-lembut">Kredit awal</dt>
          <dd class="font-semibold tabular-nums text-tinta">{SEED_CONFIG.signupCredits}</dd>
        </div>
        <div class="flex items-baseline gap-2">
          <dt class="text-tinta-lembut">Kartu kredit</dt>
          <dd class="font-semibold text-tinta">tidak perlu</dd>
        </div>
        <div class="flex items-baseline gap-2">
          <dt class="text-tinta-lembut">Langganan</dt>
          <dd class="font-semibold text-tinta">tidak ada</dd>
        </div>
      </dl>
    </div>

    <div class="lg:pt-2">
      <p class="text-xs font-semibold uppercase tracking-[0.08em] text-tinta-lembut">Contoh kerangka</p>
      <p class="mt-1 text-base font-bold text-tinta">Menanam kopi di rumah</p>
      <ol class="relative mt-5 pl-6">
        <span class="absolute bottom-2 left-[3px] top-2 w-px bg-garis" aria-hidden="true"></span>
        {contoh.map((bab, index) => (
          <li class="relative pb-6 last:pb-0">
            <span
              class:list={[
                'absolute -left-6 top-1.5 size-[7px] rounded-full',
                index === 0 ? 'bg-jalur' : 'bg-garis',
              ]}
              aria-hidden="true"
            />
            <p class="text-sm font-semibold text-tinta">{bab.judul}</p>
            <p class="mt-1 text-sm leading-[1.45] text-tinta-lembut">{bab.isi}</p>
          </li>
        ))}
      </ol>
      <p class="mt-6 border-t border-garis pt-3 text-xs text-tinta-lembut">
        Contoh kerangka, bukan jalur sungguhan.
      </p>
    </div>
  </section>

  <!-- 01 · Untuk siapa -->
  <section class="mt-20 md:mt-28" aria-labelledby="untuk-siapa-heading">
    <div class="flex items-baseline gap-4 border-t border-garis pt-5">
      <span class="text-xs font-semibold tabular-nums text-tinta-lembut">01</span>
      <p class="eyebrow">Untuk siapa</p>
    </div>
    <div class="mt-4 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <h2 id="untuk-siapa-heading" class="max-w-2xl text-2xl font-bold leading-tight text-tinta md:text-3xl">
        Tujuan berbeda, satu cara belajar yang runtut
      </h2>
      <p class="max-w-sm text-sm text-tinta-lembut md:text-right">
        Mulai dari tujuanmu, bukan dari daftar materi.
      </p>
    </div>
    <ul class="mt-8 divide-y divide-garis border-y border-garis">
      {personas.map((persona) => (
        <li class="grid gap-2 py-5 md:grid-cols-[9rem_minmax(0,1fr)_auto] md:items-baseline md:gap-6">
          <p class="text-sm tabular-nums text-tinta-lembut">{persona.label} · {persona.umur}</p>
          <div class="min-w-0">
            <p class="font-semibold text-tinta">{persona.topik}</p>
            <p class="mt-1 text-sm text-tinta-lembut">{persona.konteks}</p>
          </div>
          <p class="text-sm font-medium text-jalur md:text-right">{persona.alur}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- 02 · Cara kerja -->
  <section id="cara-kerja" class="mt-20 scroll-mt-24 md:mt-28" aria-labelledby="cara-kerja-heading">
    <div class="flex items-baseline gap-4 border-t border-garis pt-5">
      <span class="text-xs font-semibold tabular-nums text-tinta-lembut">02</span>
      <p class="eyebrow">Cara kerja</p>
    </div>
    <h2 id="cara-kerja-heading" class="mt-4 max-w-2xl text-2xl font-bold leading-tight text-tinta md:text-3xl">
      Dari satu kalimat jadi jalur yang bisa kamu selesaikan
    </h2>
    <ol class="mt-10 grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-5">
      {langkah.map((step, index) => (
        <li class="border-t border-garis pt-4">
          <p class="text-xs font-semibold tabular-nums text-jalur">{String(index + 1).padStart(2, '0')}</p>
          <h3 class="mt-2 font-semibold text-tinta">{step.judul}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-tinta-lembut">{step.isi}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 03 · Kenapa Otodidak -->
  <section class="mt-20 md:mt-28" aria-labelledby="masalah-heading">
    <div class="flex items-baseline gap-4 border-t border-garis pt-5">
      <span class="text-xs font-semibold tabular-nums text-tinta-lembut">03</span>
      <p class="eyebrow">Kenapa Otodidak</p>
    </div>
    <h2 id="masalah-heading" class="mt-4 max-w-2xl text-2xl font-bold leading-tight text-tinta md:text-3xl">
      Chat AI menjawab. Otodidak menyusun jalurnya.
    </h2>

    <div class="mt-10 divide-y divide-garis border-y border-garis">
      {masalah.map((item, index) => (
        <div class="grid gap-2 py-5 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start lg:gap-16">
          <div class="grid gap-1 sm:grid-cols-[2.5rem_minmax(0,1fr)] sm:gap-4">
            <p class="text-xs font-semibold tabular-nums text-jalur" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </p>
            <div class="min-w-0">
              <h3 class="font-semibold text-tinta">{item.judul}</h3>
              <p class="mt-1 text-sm leading-relaxed text-tinta-lembut">{item.isi}</p>
            </div>
          </div>
          <p class="text-sm leading-relaxed text-tinta">
            <span class="text-tinta-lembut">Yang Otodidak lakukan: </span>{item.jawaban}
          </p>
        </div>
      ))}
    </div>

    <dl class="mt-8 grid gap-6 border-t border-garis pt-5 lg:grid-cols-2 lg:gap-12">
      {prinsip.map((item) => (
        <div>
          <dt class="font-semibold text-tinta">{item.judul}</dt>
          <dd class="mt-1 text-sm leading-relaxed text-tinta-lembut">{item.isi}</dd>
        </div>
      ))}
    </dl>

    <p class="mt-8 max-w-2xl border-l-2 border-jalur pl-5 text-sm leading-relaxed text-tinta-lembut">
      Bukan menggantikan rasa ingin tahumu. Kamu tetap yang memilih topik dan tempo belajarnya — Otodidak menjaga langkahnya tetap runtut dan tidak melompat.
    </p>
  </section>


  <!-- 04 · FAQ -->
  <section class="mt-20 md:mt-28" aria-labelledby="faq-heading">
    <div class="flex items-baseline gap-4 border-t border-garis pt-5">
      <span class="text-xs font-semibold tabular-nums text-tinta-lembut">04</span>
      <p class="eyebrow">FAQ</p>
    </div>
    <h2 id="faq-heading" class="mt-4 max-w-2xl text-2xl font-bold leading-tight text-tinta md:text-3xl">
      Pertanyaan yang sering muncul
    </h2>
    <div class="mt-6 divide-y divide-garis border-y border-garis">
      {faq.map((item) => (
        <details class="group">
          <summary class="flex min-h-14 w-full cursor-pointer items-center justify-between gap-4 py-4 text-left font-semibold text-tinta">
            <h3 class="max-w-2xl text-base font-semibold">{item.t}</h3>
            <svg class="size-4 shrink-0 text-tinta-lembut transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="max-w-[62ch] pb-5 pr-8 text-sm leading-relaxed text-tinta-lembut">{item.j}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA penutup -->
  <section class="mt-20 border-t border-garis pt-12 md:mt-28 md:pt-16" aria-labelledby="cta-heading">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow">Mulai dari satu topik</p>
        <h2 id="cta-heading" class="mt-3 text-2xl font-bold leading-tight text-tinta md:text-4xl">
          Ada yang ingin kamu kuasai? Beri dia sebuah jalur.
        </h2>
        <p class="mt-3 text-base text-tinta-lembut">
          Cukup satu topik untuk mulai. Jalurnya tersusun rapi, kamu tinggal mengikuti.
        </p>
      </div>
      <div class="shrink-0">
        <AuthButton
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-kontrol bg-jalur px-8 text-base font-semibold text-white transition-[filter] hover:brightness-110 max-md:hidden"
          label="Mulai gratis dengan Google"
          real={realAuth}
        />
        <p class="mt-3 text-sm text-tinta-lembut md:text-right">
          Tanpa langganan bulanan · isi ulang saat kamu butuh
        </p>
      </div>
    </div>
  </section>

  <div
    class="bar-aksi-bawah md:hidden"
    role="region"
    aria-label="Mulai belajar"
  >
    <AuthButton class="btn-jalur w-full" label="Mulai gratis dengan Google" real={realAuth} icon={false} />
  </div>
  {realAuth && <script type="module" src="/scripts/auth.js"></script>}
</Shell>
