---
import { env } from 'cloudflare:workers';
import Shell from '../components/Shell.astro';
import { AppError } from '../domain/errors';
import { isRecord, record } from '../domain/guard';
import { activateUserPath } from '../server/path-actions';
import { library } from '../server/read';
import { pageMe } from '../server/ssr';

const page = await pageMe(Astro.request, env);
if ('redirect' in page) return Astro.redirect(page.redirect);
const { session, me: meRaw } = page;
const me = record(meRaw);
const user = record(me.user);
let message = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('csrf') ?? '') !== Astro.locals.csrf)
    message = 'Muat ulang halaman, lalu kirim lagi.';
  else {
    try {
      await activateUserPath(
        session.db,
        session.user.id,
        String(form.get('pathId') ?? ''),
      );
      return Astro.redirect('/pustaka');
    } catch (error) {
      message =
        error instanceof AppError ? error.message : 'Gagal mengaktifkan jalur.';
    }
  }
}
const pathsRaw = (await library(session.db, session.user.id)).filter(isRecord);
const sort = Astro.url.searchParams.get('urut') ?? 'terbaru';
const query = (Astro.url.searchParams.get('cari') ?? '').trim();
const queryLower = query.toLowerCase();
function progressPercent(path: Record<string, unknown>): number {
  const progress = record(path.progress);
  const done = Number(progress.done ?? 0);
  const total = Number(progress.total ?? 0);
  return total > 0 ? Math.round((done / total) * 100) : 0;
}
function pathIsComplete(path: Record<string, unknown>): boolean {
  const progress = record(path.progress);
  const done = Number(progress.done ?? 0);
  const total = Number(progress.total ?? 0);
  return done === total && total > 0;
}
const STATUS_IDS = ['semua', 'aktif', 'selesai'] as const;
type StatusId = (typeof STATUS_IDS)[number];
const statusRaw = Astro.url.searchParams.get('status') ?? 'semua';
const status: StatusId = STATUS_IDS.includes(statusRaw as StatusId)
  ? (statusRaw as StatusId)
  : 'semua';
const searched = queryLower
  ? pathsRaw.filter((path) => {
      const title = String(path.title ?? '').toLowerCase();
      const topic = String(path.topic ?? '').toLowerCase();
      return title.includes(queryLower) || topic.includes(queryLower);
    })
  : pathsRaw;
const filtered =
  status === 'semua'
    ? searched
    : searched.filter((path) =>
        status === 'aktif' ? path.isActive === true : pathIsComplete(path),
      );
const paths = [...filtered].sort((left, right) => {
  if (sort === 'judul')
    return String(left.title ?? '').localeCompare(
      String(right.title ?? ''),
      'id',
    );
  if (sort === 'progress')
    return progressPercent(right) - progressPercent(left);
  return 0;
});
function listHref(parts?: {
  urut?: string;
  status?: StatusId;
  clearSearch?: boolean;
}): string {
  const url = new URL('/pustaka', Astro.url);
  const urut = parts?.urut ?? sort;
  const statusVal = parts?.status ?? status;
  const cari = parts?.clearSearch ? '' : query;
  if (urut !== 'terbaru') url.searchParams.set('urut', urut);
  if (cari) url.searchParams.set('cari', cari);
  if (statusVal !== 'semua') url.searchParams.set('status', statusVal);
  const search = url.searchParams.toString();
  return search ? `${url.pathname}?${search}` : url.pathname;
}
const sortOptions = [
  { id: 'terbaru', label: 'Terbaru' },
  { id: 'progress', label: 'Progress' },
  { id: 'judul', label: 'A–Z' },
] as const;
const statusOptions = [
  { id: 'semua', label: 'Semua' },
  { id: 'aktif', label: 'Aktif' },
  { id: 'selesai', label: 'Selesai' },
] as const;
const statusLabel =
  statusOptions.find((o) => o.id === status)?.label ?? 'Semua';
const filtering = Boolean(query) || status !== 'semua';
---
<Shell title="Pustaka" balance={typeof me.balance === 'number' ? me.balance : 0} role={user.role === 'admin' ? 'admin' : 'learner'} suspended={user.status === 'suspended'}>
  <!-- Header Section -->
  <div class="mb-6 flex flex-col gap-4 min-[768px]:flex-row min-[768px]:items-center min-[768px]:justify-between">
    <div>
      <h1 class="judul">Pustaka</h1>
      <p class="mt-1 text-tinta-lembut">
        {pathsRaw.length === 0
          ? 'Koleksi jalur pembelajaran kosong'
          : filtering
            ? `${paths.length} dari ${pathsRaw.length} jalur ditampilkan`
            : `${paths.length} jalur pembelajaran`}
      </p>
    </div>
    <a class="btn-jalur w-full min-[768px]:w-auto" href="/dasbor?baru=1">
      <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Jalur Baru
    </a>
  </div>

  {message && (
    <div class="mb-6 rounded-kontrol border border-bahaya/30 bg-bahaya/10 p-4">
      <div class="flex gap-3">
        <svg class="size-5 shrink-0 text-bahaya" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-sm text-bahaya">{message}</p>
      </div>
    </div>
  )}

  {pathsRaw.length === 0 ? (
    <div class="rounded-kartu border border-garis bg-kartu p-8 text-center shadow-sm min-[768px]:p-12">
      <div class="mx-auto flex size-16 items-center justify-center rounded-kontrol bg-jalur-lembut text-jalur">
        <svg class="size-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
        </svg>
      </div>
      <h2 class="mt-4 text-xl font-bold text-tinta">Belum Ada Jalur Belajar</h2>
      <p class="mx-auto mt-2 max-w-md text-tinta-lembut">
        Mulai perjalanan belajarmu dengan membuat jalur pertama. Tulis topik yang ingin kamu kuasai dan kami akan menyusun roadmap untukmu.
      </p>
      <a 
        class="mt-6 inline-flex min-h-11 items-center gap-2 rounded-kontrol bg-jalur px-6 font-semibold text-white shadow-md transition-all hover:shadow-lg hover:brightness-110" 
        href="/dasbor?baru=1"
      >
        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Buat Jalur Pertama
      </a>
    </div>
  ) : (
    <>
    <form class="mb-4 flex flex-col gap-2 min-[640px]:flex-row" method="get" role="search">
      {sort !== 'terbaru' && <input type="hidden" name="urut" value={sort} />}
      {status !== 'semua' && <input type="hidden" name="status" value={status} />}
      <label class="sr-only" for="cari-jalur">Cari jalur pembelajaran</label>
      <input
        id="cari-jalur"
        class="min-h-11 flex-1 rounded-kontrol border border-garis bg-kartu px-3 text-tinta placeholder:text-tinta-lembut focus:border-jalur"
        type="search"
        name="cari"
        value={query}
        placeholder="Cari judul atau topik…"
        autocomplete="off"
      />
      <button
        class="min-h-11 rounded-kontrol border border-garis bg-kartu px-4 text-sm font-medium text-tinta hover:border-jalur/40"
        type="submit"
      >
        Cari
      </button>
    </form>
    <div class="mb-4 flex flex-wrap items-center gap-2" role="group" aria-label="Urutkan jalur">
      <span class="text-sm text-tinta-lembut">Urutkan:</span>
      {sortOptions.map((option) => (
        <a
          class:list={[
            'rounded-kontrol border px-3 py-1.5 text-sm font-medium transition-colors',
            sort === option.id
              ? 'border-jalur bg-jalur-lembut text-jalur'
              : 'border-garis bg-kartu text-tinta hover:border-jalur/40',
          ]}
          href={listHref({ urut: option.id })}
          aria-current={sort === option.id ? 'true' : undefined}
        >
          {option.label}
        </a>
      ))}
    </div>
    <div class="mb-4 flex flex-wrap items-center gap-2" role="group" aria-label="Filter status jalur">
      <span class="text-sm text-tinta-lembut">Status:</span>
      {statusOptions.map((option) => (
        <a
          class:list={[
            'rounded-kontrol border px-3 py-1.5 text-sm font-medium transition-colors',
            status === option.id
              ? 'border-jalur bg-jalur-lembut text-jalur'
              : 'border-garis bg-kartu text-tinta hover:border-jalur/40',
          ]}
          href={listHref({ status: option.id })}
          aria-current={status === option.id ? 'true' : undefined}
        >
          {option.label}
        </a>
      ))}
    </div>
    {paths.length === 0 ? (
      <div class="rounded-kartu border border-garis bg-kartu p-8 text-center shadow-sm">
        {query ? (
          <p class="text-tinta-lembut">
            Tidak ada jalur yang cocok dengan “{query}”
            {status !== 'semua' ? ` (status: ${statusLabel.toLowerCase()})` : ''}.
          </p>
        ) : (
          <p class="text-tinta-lembut">Tidak ada jalur berstatus “{statusLabel}”.</p>
        )}
        <a
          class="mt-4 inline-flex min-h-11 items-center text-sm font-medium text-jalur hover:underline"
          href={listHref({ status: 'semua', clearSearch: true })}
        >
          Reset filter
        </a>
      </div>
    ) : (
    <ul class="grid gap-4 min-[768px]:grid-cols-2 min-[1100px]:grid-cols-3">
      {paths.map((path) => {
        const progress = record(path.progress);
        const done = Number(progress.done ?? 0);
        const total = Number(progress.total ?? 0);
        const percentage = total > 0 ? Math.round((done / total) * 100) : 0;
        const isActive = path.isActive === true;
        const isComplete = done === total && total > 0;
        
        let progressColor = 'bg-bahaya';
        if (percentage > 70) progressColor = 'bg-jalur';
        else if (percentage > 30) progressColor = 'bg-hangat';
        
        const headerBg = isActive 
          ? 'bg-gradient-to-br from-jalur-lembut to-jalur/20' 
          : 'bg-gradient-to-br from-kertas to-garis/20';
        const iconStyle = isActive ? 'bg-jalur text-white' : 'bg-kartu text-jalur';
        
        return (
          <li class="group hover-lift flex flex-col overflow-hidden rounded-kartu border border-garis bg-kartu shadow-sm transition-[box-shadow,border-color] hover:shadow-md hover:border-jalur/30">
            <div class={`relative flex h-32 items-center justify-center ${headerBg}`}>
              <div class={`flex size-16 items-center justify-center rounded-kontrol ${iconStyle} shadow-md`}>
                <svg class="size-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                </svg>
              </div>
              {isActive && (
                <div class="absolute right-3 top-3">
                  <div class="flex items-center gap-1 rounded-kontrol bg-jalur px-2 py-1 text-xs font-semibold text-white shadow-md">
                    <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Aktif
                  </div>
                </div>
              )}
              {isComplete && !isActive && (
                <div class="absolute right-3 top-3">
                  <div class="flex items-center gap-1 rounded-kontrol bg-jalur px-2 py-1 text-xs font-semibold text-white shadow-md">
                    <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    Selesai
                  </div>
                </div>
              )}
            </div>

            <div class="flex flex-1 flex-col p-4">
              <a class="inline-flex items-start text-lg font-semibold text-tinta transition-colors hover:text-jalur" href={`/jalur/${String(path.id)}`}>
                {String(path.title)}
              </a>

              <div class="mt-3">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-tinta-lembut">Progress</span>
                  <span class="font-semibold tabular-nums text-tinta">{percentage}%</span>
                </div>
                <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-kertas">
                  <div 
                    class={`h-full transition-all ${progressColor}`}
                    style={`width: ${percentage}%`}
                  ></div>
                </div>
                <p class="mt-2 text-sm text-tinta-lembut">
                  {done} dari {total} pelajaran selesai
                </p>
              </div>

              <div class="mt-4">
                {isActive ? (
                  <a 
                    class="flex min-h-11 w-full items-center justify-center gap-2 rounded-kontrol bg-jalur px-4 font-semibold text-white shadow-md transition-all hover:shadow-lg hover:brightness-110" 
                    href={`/jalur/${String(path.id)}`}
                  >
                    <span>Lanjutkan</span>
                    <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </a>
                ) : (
                  <div class="flex gap-2">
                    <a 
                      class="flex min-h-11 flex-1 items-center justify-center rounded-kontrol border border-garis bg-kartu font-medium text-tinta transition-all hover:bg-kertas" 
                      href={`/jalur/${String(path.id)}`}
                    >
                      Lihat Detail
                    </a>
                    <form method="post" class="flex-1">
                      <input type="hidden" name="csrf" value={Astro.locals.csrf} />
                      <input type="hidden" name="pathId" value={String(path.id)} />
                      <button 
                        class="w-full min-h-11 rounded-kontrol border border-jalur bg-jalur-lembut font-medium text-jalur transition-all hover:bg-jalur hover:text-white" 
                        type="submit"
                      >
                        Aktifkan
                      </button>
                    </form>
                  </div>
                )}
              </div>
            </div>
          </li>
        );
      })}
    </ul>
    )}
    </>
  )}
</Shell>
