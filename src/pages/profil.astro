---
import { env } from 'cloudflare:workers';
import Shell from '../components/Shell.astro';
import { record } from '../domain/guard';
import { callApi, errorOf } from '../server/call';

const meResult = await callApi(Astro.request, env, '/api/me');
if (meResult.status !== 200) return Astro.redirect('/masuk');
let me = record(meResult.data);
const user = record(me.user);
let message = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('csrf') ?? '') !== Astro.locals.csrf)
    message = 'Muat ulang halaman, lalu kirim lagi.';
  else if (String(form.get('aksi') ?? '') === 'keluar') {
    const result = await callApi(Astro.request, env, '/api/session/logout', {
      method: 'POST',
      json: {},
      csrf: Astro.locals.csrf,
    });
    const headers = new Headers({ Location: '/' });
    for (const cookie of result.setCookie) headers.append('set-cookie', cookie);
    return new Response(null, { status: 303, headers });
  } else if (String(form.get('aksi') ?? '') === 'hapus') {
    const result = await callApi(
      Astro.request,
      env,
      '/api/profile/deletion-request',
      { method: 'POST', json: {}, csrf: Astro.locals.csrf },
    );
    const error = errorOf(result.data);
    message = error
      ? error.message
      : 'Permintaan penghapusan tercatat. Admin yang menyelesaikan penghapusan materi.';
    const again = await callApi(Astro.request, env, '/api/me');
    if (isRecord(again.data)) me = again.data;
  } else {
    const result = await callApi(Astro.request, env, '/api/profile/streak', {
      method: 'POST',
      json: { enabled: form.get('enabled') === '1' },
      csrf: Astro.locals.csrf,
    });
    const error = errorOf(result.data);
    if (error) message = error.message;
    else return Astro.redirect('/profil');
  }
}
const enabled = record(me.user).streakEnabled === true;

function isRecord(value: unknown): value is Record<string, unknown> {
  return Boolean(value) && typeof value === 'object';
}
---
<Shell title="Profil" balance={typeof me.balance === 'number' ? me.balance : 0} role={user.role === 'admin' ? 'admin' : 'learner'} suspended={user.status === 'suspended'}>
  <h1 class="text-[1.75rem] leading-[1.25]">Profil</h1>
  <p class="mt-2">{user.name}</p>
  <p class="text-sm text-tinta-lembut">{user.email}</p>
  {message && <p class="mt-3 text-sm">{message}</p>}
  <form class="mt-6" method="post">
    <input type="hidden" name="csrf" value={Astro.locals.csrf} />
    <input type="hidden" name="aksi" value="runtun" />
    <input type="hidden" name="enabled" value={enabled ? '0' : '1'} />
    <button class="inline-flex min-h-11 items-center rounded-kontrol border border-garis px-3" type="submit">{enabled ? 'Matikan hitungan hari' : 'Nyalakan hitungan hari'}</button>
  </form>
  <p class="mt-2 text-sm text-tinta-lembut">Hitungan yang dimatikan tidak berubah dan tidak ditampilkan.</p>
  {user.deletionRequestedAt ? (
    <p class="mt-6 text-sm">Permintaan penghapusan sudah dikirim.</p>
  ) : (
    <form class="mt-6" method="post">
      <input type="hidden" name="csrf" value={Astro.locals.csrf} />
      <input type="hidden" name="aksi" value="hapus" />
      <button class="inline-flex min-h-11 items-center rounded-kontrol border border-garis px-3" type="submit">Minta hapus materi belajar</button>
    </form>
  )}
  <form class="mt-6" method="post">
    <input type="hidden" name="csrf" value={Astro.locals.csrf} />
    <input type="hidden" name="aksi" value="keluar" />
    <button class="inline-flex min-h-11 items-center rounded-kontrol px-3" type="submit">Keluar</button>
  </form>
</Shell>
