---
import ChapterLinks from './ChapterLinks.astro';

interface LessonLink {
  id: string;
  title: string;
}
interface ChapterLink {
  id: string;
  title: string;
  lessons: LessonLink[];
}
interface Props {
  pathId: string;
  chapters: ChapterLink[];
  currentLessonId?: string;
  onPath?: boolean;
}
const { pathId, chapters, currentLessonId, onPath = false } = Astro.props;
---
{chapters.length > 0 && (
  <nav
    class="chapter-nav min-w-0 min-[1100px]:sticky min-[1100px]:top-20 min-[1100px]:max-h-[calc(100dvh-6rem)] min-[1100px]:overflow-y-auto min-[1100px]:pe-1"
    aria-label="Daftar bab"
  >
    <details class="daftar chapter-nav-drawer min-[1100px]:hidden">
      <summary class="rounded-kontrol border border-garis bg-kartu px-3">
        <span class="text-sm font-medium text-tinta">Daftar bab</span>
        <svg class="size-4 shrink-0" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <div class="pt-4">
        <ChapterLinks pathId={pathId} chapters={chapters} currentLessonId={currentLessonId} onPath={onPath} />
      </div>
    </details>
    <div class="hidden min-[1100px]:block">
      <p class="mb-3 text-sm font-semibold text-tinta">Daftar bab</p>
      <ChapterLinks pathId={pathId} chapters={chapters} currentLessonId={currentLessonId} onPath={onPath} />
    </div>
  </nav>
)}

<script>
  document.querySelectorAll('.chapter-nav-drawer a[href]').forEach((anchor) => {
    anchor.addEventListener('click', () => {
      const details = anchor.closest('.chapter-nav-drawer');
      if (details instanceof HTMLDetailsElement) details.open = false;
    });
  });
</script>
