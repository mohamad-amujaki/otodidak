---
import { formatIdr } from '../../domain/format';

interface Pack {
  id: string;
  name: string;
  credits: number;
  priceIdr: number;
  active: number | boolean;
  sort: number;
}

interface Props {
  packs: Pack[];
}

const { packs } = Astro.props;

const visible = [...packs]
  .filter((p) => p.active === 1 || p.active === true)
  .sort((a, b) => a.sort - b.sort);
---
<section
  class="rounded-kartu border border-garis bg-kertas/50 p-4"
  aria-label="Pratinjau tampilan pelajar"
  data-pack-preview-root
>
  <h3 class="text-sm font-semibold text-tinta">Pratinjau di halaman Kredit</h3>
  <p class="mt-1 text-xs text-tinta-lembut">Hanya paket aktif, diurutkan seperti yang dilihat pelajar.</p>
  <p
    class="mt-4 text-sm text-tinta-lembut"
    data-pack-preview-empty
    hidden={visible.length > 0}
  >
    Tidak ada paket aktif untuk ditampilkan.
  </p>
  <ul
    class="mt-4 grid gap-3 min-[640px]:grid-cols-2 min-[900px]:grid-cols-3"
    data-pack-preview-grid
    hidden={visible.length === 0}
  >
      {visible.map((pack) => (
        <li
          class="flex flex-col rounded-kartu border border-garis bg-kartu p-4 shadow-sm"
          data-preview-card
          data-pack-id={pack.id}
        >
          <h4 class="text-base font-semibold text-tinta">{pack.name}</h4>
          <p class="mt-1 text-2xl font-bold tabular-nums text-jalur">{pack.credits}</p>
          <p class="text-xs text-tinta-lembut">kredit</p>
          <p class="mt-2 text-lg font-bold text-tinta">{formatIdr(pack.priceIdr)}</p>
          <p class="text-xs text-tinta-lembut">
            {formatIdr(Math.round(pack.priceIdr / pack.credits))} / kredit
          </p>
        </li>
      ))}
  </ul>
</section>
