---
interface Column {
  label: string;
  srOnly?: boolean;
}

interface Props {
  columns?: Column[];
  grid: string;
  sticky?: boolean;
  class?: string;
  ulAttrs?: Record<string, string>;
}

const {
  columns = [],
  grid,
  sticky = true,
  class: className = '',
  ulAttrs = {},
} = Astro.props;
---
<div class:list={['rounded-kartu border border-garis bg-kartu shadow-sm', className]}>
  <slot name="atas" />
  {columns.length > 0 && (
    <div
      class:list={[
        'hidden lg:grid lg:rounded-t-[11px] lg:border-b lg:border-garis lg:bg-kertas/95 lg:px-4 lg:py-2.5 lg:text-xs lg:font-semibold lg:uppercase lg:tracking-wide lg:text-tinta-lembut lg:backdrop-blur-sm',
        sticky && 'lg:sticky lg:top-[var(--header-h)] lg:z-10',
        grid,
      ]}
    >
      {columns.map((column) => (
        <span>
          {column.srOnly ? <span class="sr-only">{column.label}</span> : column.label}
        </span>
      ))}
    </div>
  )}
  <ul
    class="divide-y divide-garis overflow-hidden rounded-[11px]"
    {...ulAttrs}
  >
    <slot />
  </ul>
</div>
