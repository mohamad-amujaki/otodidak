---
interface LessonLink {
  id: string;
  title: string;
}
interface ChapterLink {
  id: string;
  title: string;
  lessons: LessonLink[];
}
interface Props {
  pathId: string;
  chapters: ChapterLink[];
  currentLessonId?: string;
  onPath?: boolean;
}
const { pathId, chapters, currentLessonId, onPath = false } = Astro.props;
---
<div class="space-y-2">
  {chapters.map((chapter, chapterIndex) => {
    const hasCurrentLesson = chapter.lessons.some(l => l.id === currentLessonId);
    
    return (
      <details 
        class="chapter-group overflow-hidden rounded-lg border border-garis bg-white shadow-sm"
        open={hasCurrentLesson || chapterIndex === 0}
      >
        <summary class="flex cursor-pointer items-center justify-between p-3 transition-colors hover:bg-kertas">
          <div class="flex items-center gap-3">
            <!-- Chapter Number Badge -->
            <div class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-jalur-lembut text-sm font-bold text-jalur">
              {chapterIndex + 1}
            </div>
            
            <div class="min-w-0 flex-1">
              <p class="font-semibold text-tinta">{chapter.title}</p>
              <!-- Progress Fraction -->
              <p class="text-xs text-tinta-lembut">
                0/{chapter.lessons.length}
              </p>
            </div>
          </div>

          <!-- Chevron -->
          <svg class="size-5 shrink-0 text-tinta-lembut transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>

        <!-- Lessons -->
        <div class="border-t border-garis bg-kertas/50 p-2">
          {chapter.lessons.map((lesson, lessonIndex) => {
            const isActive = lesson.id === currentLessonId;
            
            return (
              <a 
                href={onPath ? '#' : `/jalur/${pathId}/pelajaran/${lesson.id}`}
                class={`group flex items-center gap-3 rounded-lg p-2 transition-all ${
                  isActive 
                    ? 'bg-jalur text-white' 
                    : 'text-tinta hover:bg-white hover:shadow-sm'
                }`}
                aria-current={isActive ? "page" : undefined}
              >
                <!-- Lesson Icon -->
                <div class={`flex size-7 shrink-0 items-center justify-center rounded-lg ${
                  isActive 
                    ? 'bg-white/20' 
                    : 'bg-garis'
                }`}>
                  <span class="text-xs font-medium">{lessonIndex + 1}</span>
                </div>

                <!-- Lesson Info -->
                <div class="min-w-0 flex-1">
                  <p class={`text-sm font-medium ${isActive ? 'text-white' : 'text-tinta'}`}>
                    {lesson.title}
                  </p>
                </div>

                <!-- Arrow for active -->
                {isActive && (
                  <svg class="size-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                )}
              </a>
            );
          })}
        </div>
      </details>
    );
  })}
</div>

<style>
  details[open] > summary svg {
    transform: rotate(180deg);
  }
</style>
