---
import Shell from './Shell.astro';

interface Props {
  title: string;
  section: string;
  balance: number;
  superadmin: boolean;
}

const { title, section, balance, superadmin } = Astro.props;

const nav = [
  ['ringkasan', 'Ringkasan', '/admin'],
  ['pengguna', 'Pengguna', '/admin/pengguna'],
  ['kredit', 'Kredit', '/admin/kredit'],
  ['konfigurasi', 'Konfigurasi', '/admin/konfigurasi'],
  ['antrean', 'Antrean', '/admin/antrean'],
] as const;

const platform = [
  ['ai', 'AI', '/admin/ai'],
  ['paket', 'Paket', '/admin/paket'],
] as const;

function isActive(id: string): boolean {
  if (section === id) return true;
  if (id === 'pengguna' && section === 'pengguna-detail') return true;
  return false;
}
---
<Shell title={title} balance={balance} role="admin">
  <div class="min-[1100px]:grid min-[1100px]:grid-cols-[240px_minmax(0,1fr)] min-[1100px]:gap-8 min-[1100px]:items-start">
    <aside class="min-[1100px]:sticky min-[1100px]:top-20">
      <p class="text-xs font-semibold uppercase tracking-wider text-tinta-lembut">Konsol admin</p>
      <nav class="mt-3 flex flex-wrap gap-2 min-[1100px]:flex-col min-[1100px]:gap-1" aria-label="Navigasi admin">
        {nav.map(([id, label, href]) => (
          <a
            class:list={[
              'inline-flex min-h-10 items-center rounded-kontrol px-3 text-sm transition-colors',
              isActive(id)
                ? 'bg-jalur-lembut font-medium text-jalur'
                : 'text-tinta-lembut hover:bg-kartu hover:text-tinta',
            ]}
            href={href}
            aria-current={isActive(id) ? 'page' : undefined}
          >{label}</a>
        ))}
        {superadmin && (
          <>
            <hr class="my-2 hidden min-[1100px]:block border-garis" />
            <p class="hidden min-[1100px]:block text-xs font-semibold uppercase tracking-wider text-tinta-lembut">Platform</p>
            {platform.map(([id, label, href]) => (
              <a
                class:list={[
                  'inline-flex min-h-10 items-center rounded-kontrol px-3 text-sm transition-colors',
                  section === id
                    ? 'bg-jalur-lembut font-medium text-jalur'
                    : 'text-tinta-lembut hover:bg-kartu hover:text-tinta',
                ]}
                href={href}
                aria-current={section === id ? 'page' : undefined}
              >{label}</a>
            ))}
          </>
        )}
      </nav>
    </aside>
    <div class="min-w-0 mt-6 min-[1100px]:mt-0">
      <slot />
    </div>
  </div>
</Shell>
