---
import type { AdminNavStats } from '../server/admin-guard';
import Shell from './Shell.astro';

interface Props {
  title: string;
  section: string;
  balance: number;
  superadmin: boolean;
  navStats?: AdminNavStats;
  userName?: string;
  userEmail?: string;
}

const { title, section, balance, superadmin, navStats, userName, userEmail } =
  Astro.props;

function navCount(id: string): number {
  if (!navStats) return 0;
  if (id === 'pengguna') return navStats.deletionRequests;
  if (id === 'kredit') return navStats.pendingOrders;
  if (id === 'antrean') return navStats.jobsFailed;
  return 0;
}

function navBadgeLabel(count: number): string {
  return count > 99 ? '99+' : String(count);
}

const navItems = [
  ['ringkasan', 'Ringkasan', '/admin'],
  ['pengguna', 'Pengguna', '/admin/pengguna'],
  ['kredit', 'Kredit', '/admin/kredit'],
  ['konfigurasi', 'Konfigurasi', '/admin/konfigurasi'],
  ['antrean', 'Antrean', '/admin/antrean'],
] as const;

const platform = [
  ['ai', 'AI', '/admin/ai'],
  ['paket', 'Paket', '/admin/paket'],
] as const;

function isActive(id: string): boolean {
  if (section === id) return true;
  if (id === 'pengguna' && section === 'pengguna-detail') return true;
  return false;
}

const sectionTitles: Record<string, string> = {
  ringkasan: 'Ringkasan',
  pengguna: 'Pengguna',
  'pengguna-detail': 'Pengguna',
  kredit: 'Kredit',
  konfigurasi: 'Konfigurasi',
  antrean: 'Antrean',
  ai: 'AI',
  paket: 'Paket',
};
const mobileSectionLabel = sectionTitles[section] ?? title;
---
<Shell
  title={title}
  balance={balance}
  role="admin"
  sectionLabel={mobileSectionLabel}
  userName={userName}
  userEmail={userEmail}
>
  <div class="lg:grid lg:grid-cols-[240px_minmax(0,1fr)] lg:gap-8 lg:items-start">
    <aside class="lg:sticky lg:top-20">
      <p class="text-xs font-semibold uppercase tracking-wider text-tinta-lembut">Konsol admin</p>
      <nav class="mt-3 -mx-4 flex flex-nowrap gap-2 overflow-x-auto px-4 pb-1 lg:mx-0 lg:flex-col lg:gap-1 lg:overflow-visible lg:px-0 lg:pb-0" aria-label="Navigasi admin">
        {navItems.map(([id, label, href]) => {
          const badge = navCount(id);
          return (
            <a
              class:list={[
                'inline-flex min-h-11 shrink-0 items-center gap-2 rounded-kontrol px-3 text-sm transition-colors',
                isActive(id)
                  ? 'bg-jalur-lembut font-medium text-jalur'
                  : 'text-tinta-lembut hover:bg-kartu hover:text-tinta',
              ]}
              href={href}
              aria-current={isActive(id) ? 'page' : undefined}
            >
              <span>{label}</span>
              {badge > 0 && (
                <span
                  class="inline-flex min-w-[1.25rem] items-center justify-center rounded-full bg-bahaya/10 px-1.5 py-px text-[11px] font-semibold tabular-nums text-bahaya"
                  title={`${badge} perlu tindakan`}
                >
                  {navBadgeLabel(badge)}
                </span>
              )}
            </a>
          );
        })}
        {superadmin && (
          <>
            <hr class="my-2 hidden lg:block border-garis" />
            <p class="hidden lg:block text-xs font-semibold uppercase tracking-wider text-tinta-lembut">Platform</p>
            {platform.map(([id, label, href]) => (
              <a
                class:list={[
                  'inline-flex min-h-11 shrink-0 items-center rounded-kontrol px-3 text-sm transition-colors',
                  section === id
                    ? 'bg-jalur-lembut font-medium text-jalur'
                    : 'text-tinta-lembut hover:bg-kartu hover:text-tinta',
                ]}
                href={href}
                aria-current={section === id ? 'page' : undefined}
              >{label}</a>
            ))}
          </>
        )}
      </nav>
      <p class="mt-3 text-sm font-semibold text-tinta md:sr-only">{mobileSectionLabel}</p>
    </aside>
    <div class="min-w-0 mt-6 lg:mt-0 max-w-6xl">
      <slot />
    </div>
  </div>
</Shell>
