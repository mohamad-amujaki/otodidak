---
interface Props {
  last?: boolean;
}
const { last = false } = Astro.props;
---
<span class="relative min-h-6 w-4 shrink-0 self-stretch text-jalur" aria-hidden="true">
  {!last && (
    <svg class="absolute top-3 right-0 bottom-0 left-0 w-4" viewBox="0 0 16 100" preserveAspectRatio="none">
      <path d="M8 0v100" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke"></path>
    </svg>
  )}
  <svg class="absolute top-1 left-0 size-4" viewBox="0 0 16 16">
    <circle cx="8" cy="8" r="4" fill="currentColor"></circle>
  </svg>
</span>
