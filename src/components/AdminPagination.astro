---
interface Props {
  offset: number;
  limit: number;
  count: number;
  total?: number;
  baseUrl: string;
  extraParams?: Record<string, string>;
}

const { offset, limit, count, total, baseUrl, extraParams = {} } = Astro.props;
const prev = Math.max(0, offset - limit);
const next = offset + limit;
const hasPrev = offset > 0;
const hasNext = total !== undefined ? next < total : count >= limit;
const from = total === 0 ? 0 : offset + 1;
const to =
  total !== undefined ? Math.min(offset + count, total) : offset + count;

function href(off: number): string {
  const params = new URLSearchParams({
    ...extraParams,
    offset: String(off),
    limit: String(limit),
  });
  return `${baseUrl}?${params}`;
}
---
{(hasPrev || hasNext || total !== undefined) && (
  <nav class="mt-4 flex flex-wrap items-center justify-between gap-2 text-sm" aria-label="Paginasi">
  {hasPrev ? (
      <a class="inline-flex min-h-11 items-center rounded-kontrol border border-garis bg-kartu px-3" href={href(prev)}>← Sebelumnya</a>
    ) : (
      <span class="text-tinta-lembut">← Sebelumnya</span>
    )}
    <span class="text-tinta-lembut tabular-nums">
      {total !== undefined
        ? total === 0
          ? 'Tidak ada data'
          : `Menampilkan ${from}–${to} dari ${total}`
        : `Offset ${offset}`}
    </span>
    {hasNext ? (
      <a class="inline-flex min-h-11 items-center rounded-kontrol border border-garis bg-kartu px-3" href={href(next)}>Berikutnya →</a>
    ) : (
      <span class="text-tinta-lembut">Berikutnya →</span>
    )}
  </nav>
)}
