---
import { formatWhen } from '../domain/format';

interface Props {
  url: string;
  whatsappHref: string;
  token: string;
  views: number;
  ctaClicks?: number;
  expiresAt?: string | null;
  csrf: string;
}

const {
  url,
  whatsappHref,
  token,
  views,
  ctaClicks = 0,
  expiresAt,
  csrf,
} = Astro.props;
---

<section class="mt-5 rounded-kartu border border-garis bg-kartu p-4">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <p class="text-sm font-semibold text-tinta">Link bagikan aktif</p>
    <p class="text-xs tabular-nums text-tinta-lembut">
      Dibuka {views} kali{ctaClicks > 0 ? ` · ${ctaClicks} klik CTA` : ''}
      {expiresAt ? ` · aktif sampai ${formatWhen(expiresAt)}` : ' · tanpa masa berlaku'}
    </p>
  </div>
  <p class="mt-1 text-sm text-tinta-lembut">
    Siapa pun dengan link ini bisa membaca materinya tanpa akun. Tautan tidak masuk mesin pencari.
  </p>
  <div class="mt-3 flex flex-col gap-2 sm:flex-row">
    <input
      class="min-h-11 flex-1 rounded-kontrol border border-garis bg-kertas px-3 text-sm text-tinta"
      value={url}
      readonly
      aria-label="Link bagikan"
    />
    <div class="flex flex-wrap gap-2">
      <a
        class="btn-jalur min-h-11 px-4 text-sm"
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        Kirim ke WhatsApp
      </a>
      <button
        class="inline-flex min-h-11 items-center rounded-kontrol border border-garis bg-kartu px-4 text-sm font-medium text-tinta transition-colors hover:border-jalur/40"
        type="button"
        data-copy={url}
      >
        <span data-copy-label>Salin link</span>
      </button>
    </div>
  </div>
  <form method="post" class="mt-3">
    <input type="hidden" name="csrf" value={csrf} />
    <input type="hidden" name="aksi" value="cabut-bagikan" />
    <input type="hidden" name="token" value={token} />
    <button class="text-xs font-medium text-bahaya hover:underline" type="submit">
      Cabut link ini
    </button>
  </form>
</section>

<script src="/scripts/share-link.js" defer></script>
