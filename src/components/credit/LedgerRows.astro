---
import { ledgerReasonIcons, ledgerReasonLabels } from '../../domain/credit-ui';
import { formatWhen, formatWhenShort } from '../../domain/format';
import { isRecord } from '../../domain/guard';
import LedgerIcon from './LedgerIcon.astro';

interface Props {
  entries: unknown[];
  compact?: boolean;
  dense?: boolean;
  linkable?: boolean;
}

const {
  entries,
  compact = false,
  dense = false,
  linkable = false,
} = Astro.props;
const rows = entries.filter(isRecord);
---
{dense ? (
  <ul class="divide-y divide-garis overflow-hidden rounded-kartu border border-garis bg-kartu">
    {rows.map((entry) => {
      const reason = String(entry.reason);
      const iconType = ledgerReasonIcons[reason] || 'circle';
      const amount = Number(entry.amount);
      const isPositive = amount > 0;
      const href = linkable && typeof entry.href === 'string' ? entry.href : null;
      const contextLabel =
        typeof entry.contextLabel === 'string' ? entry.contextLabel : '';
      const label = ledgerReasonLabels[reason] ?? reason;
      const title = contextLabel ? `${label} · ${contextLabel}` : label;
      const when = formatWhenShort(String(entry.createdAt));
      const row = (
        <div class="flex min-h-11 items-center gap-2.5 px-3 py-2">
          <div
            class:list={[
              'flex size-8 shrink-0 items-center justify-center rounded-kontrol',
              isPositive ? 'bg-jalur-lembut text-jalur' : 'bg-kertas text-tinta-lembut',
            ]}
          >
            <LedgerIcon iconType={iconType} />
          </div>
          <p class="min-w-0 flex-1 truncate text-sm text-tinta">
            <span class="font-medium">{title}</span>
            <span class="hidden text-tinta-lembut min-[480px]:inline"> · {when}</span>
          </p>
          <p
            class:list={[
              'shrink-0 text-sm font-bold tabular-nums',
              isPositive ? 'text-jalur' : 'text-bahaya',
            ]}
          >
            {isPositive ? '+' : ''}{amount}
          </p>
          {href && (
            <svg class="size-4 shrink-0 text-tinta-lembut" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          )}
        </div>
      );
      return href ? (
        <li>
          <a class="block transition-colors hover:bg-kertas/60" href={href}>
            {row}
          </a>
        </li>
      ) : (
        <li>{row}</li>
      );
    })}
  </ul>
) : (
  <ul class:list={['grid gap-3', compact && 'gap-2']}>
    {rows.map((entry) => {
      const reason = String(entry.reason);
      const iconType = ledgerReasonIcons[reason] || 'circle';
      const amount = Number(entry.amount);
      const isPositive = amount > 0;
      const href = linkable && typeof entry.href === 'string' ? entry.href : null;
      const contextLabel =
        typeof entry.contextLabel === 'string' ? entry.contextLabel : '';
      const rowClass = [
        'flex items-center gap-4 border border-garis bg-kartu',
        compact
          ? 'rounded-kontrol px-3 py-2.5'
          : 'rounded-kartu p-4 shadow-sm transition-all hover:shadow-md',
        href ? 'hover:border-jalur/30' : '',
      ];
      const inner = (
        <>
          <div
            class:list={[
              'flex shrink-0 items-center justify-center rounded-kontrol',
              compact ? 'size-9' : 'size-10',
              isPositive ? 'bg-jalur-lembut text-jalur' : 'bg-kertas text-tinta-lembut',
            ]}
          >
            <LedgerIcon iconType={iconType} />
          </div>
          <div class="min-w-0 flex-1">
            <p class:list={['font-medium text-tinta', compact && 'text-sm']}>
              {ledgerReasonLabels[reason] ?? reason}
            </p>
            {contextLabel && (
              <p class="truncate text-sm text-tinta-lembut">{contextLabel}</p>
            )}
            <p class="text-sm text-tinta-lembut">{formatWhen(String(entry.createdAt))}</p>
          </div>
          <div class="text-right">
            <p
              class:list={[
                'font-bold tabular-nums',
                compact ? 'text-base' : 'text-lg',
                isPositive ? 'text-jalur' : 'text-bahaya',
              ]}
            >
              {isPositive ? '+' : ''}{amount}
            </p>
          </div>
          {href && (
            <svg class="size-5 shrink-0 text-tinta-lembut" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          )}
        </>
      );
      return href ? (
        <li>
          <a class:list={rowClass} href={href}>
            {inner}
          </a>
        </li>
      ) : (
        <li class:list={rowClass}>{inner}</li>
      );
    })}
  </ul>
)}
