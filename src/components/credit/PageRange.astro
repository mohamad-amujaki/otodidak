---
interface Props {
  offset: number;
  limit: number;
  total: number;
  noun: string;
}

const { offset, limit, total, noun } = Astro.props;
const from = total === 0 ? 0 : offset + 1;
const to = Math.min(offset + limit, total);
---
<p class="text-sm text-tinta-lembut" aria-live="polite">
  {total === 0
    ? `Tidak ada ${noun}`
  : from === to
    ? `Menampilkan ${from} dari ${total} ${noun}`
  : `Menampilkan ${from}–${to} dari ${total} ${noun}`}
</p>
